import React from 'react';

type MenuKey =
  | 'dashboard'
  | 'pendaftaran'
  | 'igd'
  | 'rawat-jalan'
  | 'rawat-inap'
  | 'farmasi'
  | 'kasir'
  | 'laporan'
  | 'admin';

type Poli = {
  kd_poli: string;
  nm_poli: string;
};

type Dokter = {
  kd_dokter: string;
  nm_dokter: string;
};

type Penjab = {
  kd_pj: string;
  nm_pj: string;
};

type RegToday = {
  no_rawat: string;
  no_rkm_medis: string;
  nm_pasien: string;
  tgl_registrasi: string;
  jam_reg: string;
  kd_poli: string;
  nm_poli: string;
  kd_dokter: string;
  nm_dokter: string;
  status_lanjut: string;
  stts: string;
};

type PatientBrief = {
  no_rkm_medis: string;
  nm_pasien: string;
  alamat: string;
  jk: string;
  tgl_lahir: string;
};

type AppUser = {
  id: number;
  username: string;
  full_name: string;
  role: 'pendaftaran' | 'dokter' | 'farmasi' | 'kasir' | 'admin';
  is_active?: boolean;
};

type LoginViewProps = {
  onLogin: (user: AppUser) => void;
};

const LoginView: React.FC<LoginViewProps> = ({ onLogin }) => {
  const [username, setUsername] = React.useState<string>('admin');
  const [password, setPassword] = React.useState<string>('admin123');
  const [loading, setLoading] = React.useState<boolean>(false);
  const [error, setError] = React.useState<string | null>(null);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    if (!username || !password) {
      setError('Isi username dan password.');
      return;
    }
    setLoading(true);
    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error((data as any).error || 'Login gagal');
      }
      const user: AppUser = (data as any).user;
      onLogin(user);
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Login gagal');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div
      style={{
        minHeight: '100vh',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        background: 'radial-gradient(circle at top left, #eff6ff 0, #e0f2fe 40%, #eef2ff 100%)',
        fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif'
      }}
    >
      <div
        style={{
          width: 360,
          maxWidth: '90%',
          background: '#ffffff',
          borderRadius: 16,
          padding: 24,
          boxShadow: '0 20px 40px rgba(15,23,42,0.15)',
          border: '1px solid rgba(148,163,184,0.25)'
        }}
      >
        <div style={{ marginBottom: 16 }}>
          <div
            style={{
              fontSize: 13,
              fontWeight: 600,
              letterSpacing: 0.4,
              color: '#2563eb',
              textTransform: 'uppercase'
            }}
          >
            SIMRS WEB
          </div>
          <h2 style={{ margin: '4px 0 4px 0', fontSize: 20 }}>Login Pengguna</h2>
          <p style={{ margin: 0, fontSize: 12, color: '#6b7280' }}>
            Masuk untuk mengakses modul sesuai hak akses Anda. (Default: admin / admin123)
          </p>
        </div>

        {error && (
          <div
            style={{
              marginBottom: 10,
              padding: 8,
              borderRadius: 8,
              background: '#fef2f2',
              color: '#b91c1c',
              fontSize: 12
            }}
          >
            {error}
          </div>
        )}

        <form onSubmit={handleSubmit}>
          <div style={{ marginBottom: 10 }}>
            <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Username</label>
            <input
              type="text"
              value={username}
              onChange={(e) => setUsername(e.target.value)}
              style={{
                width: '100%',
                padding: '6px 10px',
                borderRadius: 8,
                border: '1px solid #d1d5db',
                fontSize: 13
              }}
            />
          </div>
          <div style={{ marginBottom: 12 }}>
            <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Password</label>
            <input
              type="password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              style={{
                width: '100%',
                padding: '6px 10px',
                borderRadius: 8,
                border: '1px solid #d1d5db',
                fontSize: 13
              }}
            />
          </div>
          <button
            type="submit"
            disabled={loading}
            style={{
              width: '100%',
              padding: '8px 12px',
              borderRadius: 999,
              border: 'none',
              background: loading ? '#9ca3af' : '#2563eb',
              color: '#fff',
              cursor: loading ? 'default' : 'pointer',
              fontSize: 14,
              fontWeight: 600
            }}
          >
            {loading ? 'Masuk...' : 'Masuk'}
          </button>
        </form>
      </div>
    </div>
  );
};

const RawatJalanView: React.FC = () => {
  const [activeTab, setActiveTab] = React.useState<'poli-today' | 'rujukan-internal'>('poli-today');
  const [poliToday, setPoliToday] = React.useState<any[]>([]);
  const [rujukanInternal, setRujukanInternal] = React.useState<any[]>([]);
  const [loading, setLoading] = React.useState<boolean>(false);
  const [error, setError] = React.useState<string | null>(null);

  const [tglDari, setTglDari] = React.useState<string>(new Date().toISOString().split('T')[0]);
  const [tglSampai, setTglSampai] = React.useState<string>(new Date().toISOString().split('T')[0]);
  const [searchText, setSearchText] = React.useState<string>('');
  const [showFilterDropdown, setShowFilterDropdown] = React.useState<boolean>(false);

  const loadPoliToday = async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/rawat-jalan/poli-today?tgl_dari=${tglDari}&tgl_sampai=${tglSampai}`
      );
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Gagal mengambil data poli hari ini');
      }
      setPoliToday(Array.isArray(data) ? data : []);
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan');
    } finally {
      setLoading(false);
    }
  };

  const loadRujukanInternal = async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/rawat-jalan/rujukan-internal?tgl_dari=${tglDari}&tgl_sampai=${tglSampai}`
      );
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Gagal mengambil data rujukan internal');
      }
      setRujukanInternal(Array.isArray(data) ? data : []);
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan');
    } finally {
      setLoading(false);
    }
  };

  React.useEffect(() => {
    if (activeTab === 'poli-today') {
      void loadPoliToday();
    } else {
      void loadRujukanInternal();
    }
  }, [activeTab, tglDari, tglSampai]);

  const filteredPoliToday = React.useMemo(() => {
    const search = searchText.trim().toLowerCase();
    if (!search) return poliToday;
    return poliToday.filter((p) => {
      const haystack = `${p.no_rkm_medis} ${p.nm_pasien} ${p.nm_dokter} ${p.nm_poli}`.toLowerCase();
      return haystack.includes(search);
    });
  }, [poliToday, searchText]);

  const filteredRujukanInternal = React.useMemo(() => {
    const search = searchText.trim().toLowerCase();
    if (!search) return rujukanInternal;
    return rujukanInternal.filter((r) => {
      const haystack = `${r.no_rkm_medis} ${r.nm_pasien} ${r.nm_dokter} ${r.nm_poli}`.toLowerCase();
      return haystack.includes(search);
    });
  }, [rujukanInternal, searchText]);

  return (
    <>
      {/* Header dengan Filter Button - Di atas card */}
      <div
        style={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          marginBottom: 16
        }}
      >
        <div>
          <h2 style={{ marginTop: 0, marginBottom: 4 }}>Rawat Jalan</h2>
          <p style={{ margin: 0, color: '#6b7280', fontSize: 13 }}>
            Daftar pasien rawat jalan berdasarkan pendaftaran poli dan rujukan internal.
          </p>
        </div>

        {/* Filter Button with Dropdown */}
        <div style={{ position: 'relative' }}>
          <button
            onClick={() => setShowFilterDropdown(!showFilterDropdown)}
            style={{
              padding: '8px 16px',
              borderRadius: 8,
              border: '1px solid #d1d5db',
              background: '#ffffff',
              color: '#374151',
              cursor: 'pointer',
              fontSize: 12,
              fontWeight: 500,
              display: 'flex',
              alignItems: 'center',
              gap: 6
            }}
          >
            <span>Filter</span>
            <span style={{ fontSize: 10 }}>▼</span>
          </button>

          {/* Dropdown Filter */}
          {showFilterDropdown && (
            <div
              style={{
                position: 'absolute',
                top: '100%',
                right: 0,
                marginTop: 4,
                padding: 16,
                background: '#ffffff',
                border: '1px solid #e5e7eb',
                borderRadius: 12,
                boxShadow: '0 10px 25px rgba(0,0,0,0.1)',
                zIndex: 100,
                minWidth: 300
              }}
            >
              <div style={{ marginBottom: 12 }}>
                <input
                  type="date"
                  value={tglDari}
                  onChange={(e) => setTglDari(e.target.value)}
                  style={{
                    width: '100%',
                    padding: '6px 8px',
                    borderRadius: 8,
                    border: '1px solid #d1d5db',
                    fontSize: 12
                  }}
                />
              </div>
              <div style={{ marginBottom: 12 }}>
                <input
                  type="date"
                  value={tglSampai}
                  onChange={(e) => setTglSampai(e.target.value)}
                  style={{
                    width: '100%',
                    padding: '6px 8px',
                    borderRadius: 8,
                    border: '1px solid #d1d5db',
                    fontSize: 12
                  }}
                />
              </div>
            </div>
          )}
        </div>
      </div>
  return (
    
    <section
    
      style={{
        background: '#ffffff',
        borderRadius: 16,
        padding: 24,
        boxShadow: '0 10px 30px rgba(15,23,42,0.08)',
        border: '1px solid #e5e7eb'
      }}
    >
      

      {error && (
        <div
          style={{
            marginBottom: 16,
            padding: 10,
            borderRadius: 8,
            background: '#fef2f2',
            color: '#b91c1c',
            fontSize: 13
          }}
        >
          {error}
        </div>
      )}

      {/* Tab Navigation */}
      <div
        style={{
          display: 'flex',
          gap: 16,
          marginBottom: 16,
          borderBottom: '2px solid #e5e7eb',
          alignItems: 'flex-end',
          flexWrap: 'wrap'
        }}
      >
        <button
          onClick={() => setActiveTab('poli-today')}
          style={{
            padding: '10px 20px',
            border: 'none',
            background: 'transparent',
            borderBottom: activeTab === 'poli-today' ? '3px solid #2563eb' : '3px solid transparent',
            color: activeTab === 'poli-today' ? '#2563eb' : '#6b7280',
            cursor: 'pointer',
            fontSize: 13,
            fontWeight: activeTab === 'poli-today' ? 600 : 400,
            transition: 'all 0.2s'
          }}
        >
          Poli Hari Ini ({filteredPoliToday.length})
        </button>
        <button
          onClick={() => setActiveTab('rujukan-internal')}
          style={{
            padding: '10px 20px',
            border: 'none',
            background: 'transparent',
            borderBottom: activeTab === 'rujukan-internal' ? '3px solid #2563eb' : '3px solid transparent',
            color: activeTab === 'rujukan-internal' ? '#2563eb' : '#6b7280',
            cursor: 'pointer',
            fontSize: 13,
            fontWeight: activeTab === 'rujukan-internal' ? 600 : 400,
            transition: 'all 0.2s'
          }}
        >
          Rujukan Poli Internal ({filteredRujukanInternal.length})
        </button>

        {/* Search box */}
        <div style={{ marginLeft: 'auto', paddingBottom: 8 }}>
          <input
            type="text"
            value={searchText}
            onChange={(e) => setSearchText(e.target.value)}
            placeholder="Cari No. RM / Nama / Dokter"
            style={{
              width: 250,
              padding: '6px 12px',
              borderRadius: 8,
              border: '1px solid #d1d5db',
              fontSize: 12
            }}
          />
        </div>
      </div>

      {/* Tab Content */}
      {activeTab === 'poli-today' && (
        <div
          style={{
            borderRadius: 12,
            border: '1px solid #e5e7eb',
            overflow: 'auto',
            maxHeight: 600
          }}
        >
          <table
            style={{
              width: '100%',
              borderCollapse: 'collapse',
              fontSize: 12
            }}
          >
            <thead style={{ position: 'sticky', top: 0, background: '#f3f4f6', zIndex: 1 }}>
              <tr>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>No. RM</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Nama Pasien</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>No. Reg</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Dokter</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Poli</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Umur</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Tgl Reg</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Jam</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Cara Bayar</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>No. Rawat</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Status</th>
              </tr>
            </thead>
            <tbody>
              {filteredPoliToday.map((p, idx) => (
                <tr key={idx} style={{ background: idx % 2 === 0 ? '#ffffff' : '#f9fafb' }}>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{p.no_rkm_medis}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{p.nm_pasien}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{p.no_reg}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{p.nm_dokter}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{p.nm_poli}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{p.umur}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{p.tgl_registrasi}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{p.jam_reg}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{p.png_jawab}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb', whiteSpace: 'nowrap' }}>
                    {p.no_rawat}
                  </td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>
                    <span
                      style={{
                        padding: '2px 8px',
                        borderRadius: 999,
                        background: p.stts === 'Sudah' ? '#ecfdf3' : '#fef3c7',
                        color: p.stts === 'Sudah' ? '#166534' : '#92400e',
                        fontSize: 11,
                        fontWeight: 500
                      }}
                    >
                      {p.stts}
                    </span>
                  </td>
                </tr>
              ))}
              {filteredPoliToday.length === 0 && (
                <tr>
                  <td
                    colSpan={11}
                    style={{
                      padding: 20,
                      textAlign: 'center',
                      color: '#9ca3af',
                      borderBottom: '1px solid #e5e7eb'
                    }}
                  >
                    {loading ? 'Memuat data...' : 'Tidak ada data pasien poli hari ini'}
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}

      {activeTab === 'rujukan-internal' && (
        <div
          style={{
            borderRadius: 12,
            border: '1px solid #e5e7eb',
            overflow: 'auto',
            maxHeight: 600
          }}
        >
          <table
            style={{
              width: '100%',
              borderCollapse: 'collapse',
              fontSize: 12
            }}
          >
            <thead style={{ position: 'sticky', top: 0, background: '#f3f4f6', zIndex: 1 }}>
              <tr>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>No. RM</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Nama Pasien</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Dokter</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Poli Tujuan</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Umur</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Tgl Reg</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Jam</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Cara Bayar</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>No. Rawat</th>
                <th style={{ padding: '8px', textAlign: 'left', borderBottom: '2px solid #e5e7eb' }}>Status</th>
              </tr>
            </thead>
            <tbody>
              {filteredRujukanInternal.map((r, idx) => (
                <tr key={idx} style={{ background: idx % 2 === 0 ? '#ffffff' : '#f9fafb' }}>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{r.no_rkm_medis}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{r.nm_pasien}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{r.nm_dokter}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{r.nm_poli}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{r.umur}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{r.tgl_registrasi}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{r.jam_reg}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>{r.png_jawab}</td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb', whiteSpace: 'nowrap' }}>
                    {r.no_rawat}
                  </td>
                  <td style={{ padding: '6px 8px', borderBottom: '1px solid #e5e7eb' }}>
                    <span
                      style={{
                        padding: '2px 8px',
                        borderRadius: 999,
                        background: r.stts === 'Sudah' ? '#ecfdf3' : '#fef3c7',
                        color: r.stts === 'Sudah' ? '#166534' : '#92400e',
                        fontSize: 11,
                        fontWeight: 500
                      }}
                    >
                      {r.stts}
                    </span>
                  </td>
                </tr>
              ))}
              {filteredRujukanInternal.length === 0 && (
                <tr>
                  <td
                    colSpan={10}
                    style={{
                      padding: 20,
                      textAlign: 'center',
                      color: '#9ca3af',
                      borderBottom: '1px solid #e5e7eb'
                    }}
                  >
                    {loading ? 'Memuat data...' : 'Tidak ada data rujukan internal hari ini'}
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}
    </section>
  );
};

const AdminUsersView: React.FC = () => {
  const [users, setUsers] = React.useState<AppUser[]>([]);
  const [loading, setLoading] = React.useState<boolean>(false);
  const [error, setError] = React.useState<string | null>(null);
  const [savingId, setSavingId] = React.useState<number | null>(null);
  const [creating, setCreating] = React.useState<boolean>(false);

  const [newUsername, setNewUsername] = React.useState<string>('');
  const [newFullName, setNewFullName] = React.useState<string>('');
  const [newPassword, setNewPassword] = React.useState<string>('');
  const [newRole, setNewRole] = React.useState<AppUser['role']>('pendaftaran');

  const loadUsers = async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch('/api/admin/users');
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Gagal mengambil data user');
      }
      setUsers(data as AppUser[]);
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan');
    } finally {
      setLoading(false);
    }
  };

  React.useEffect(() => {
    void loadUsers();
  }, []);

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    if (!newUsername || !newFullName || !newPassword || !newRole) {
      setError('Lengkapi username, nama lengkap, password, dan role.');
      return;
    }
    setCreating(true);
    try {
      const res = await fetch('/api/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: newUsername,
          password: newPassword,
          full_name: newFullName,
          role: newRole
        })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error((data as any).error || 'Gagal membuat user');
      }
      setNewUsername('');
      setNewFullName('');
      setNewPassword('');
      setNewRole('pendaftaran');
      await loadUsers();
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan saat membuat user');
    } finally {
      setCreating(false);
    }
  };

  const handleUpdate = async (u: AppUser) => {
    setSavingId(u.id);
    setError(null);
    try {
      const res = await fetch(`/api/admin/users/${u.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          full_name: u.full_name,
          role: u.role,
          is_active: u.is_active ?? true
        })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error((data as any).error || 'Gagal menyimpan perubahan user');
      }
      await loadUsers();
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan saat menyimpan user');
    } finally {
      setSavingId(null);
    }
  };

  const handleResetPassword = async (u: AppUser) => {
    const confirmReset = window.confirm(
      `Reset password user "${u.username}" ke nilai default "123456"?`
    );
    if (!confirmReset) return;
    setSavingId(u.id);
    setError(null);
    try {
      const res = await fetch(`/api/admin/users/${u.id}/reset-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: '123456' })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error((data as any).error || 'Gagal reset password');
      }
      alert(`Password user "${u.username}" telah direset ke: 123456`);
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan saat reset password');
    } finally {
      setSavingId(null);
    }
  };

  const handleToggleActive = (id: number, value: boolean) => {
    setUsers((prev) =>
      prev.map((u) =>
        u.id === id
          ? {
              ...u,
              is_active: value
            }
          : u
      )
    );
  };

  const handleRoleChange = (id: number, role: AppUser['role']) => {
    setUsers((prev) =>
      prev.map((u) =>
        u.id === id
          ? {
              ...u,
              role
            }
          : u
      )
    );
  };

  return (
    <section
      style={{
        background: '#ffffff',
        borderRadius: 16,
        padding: 24,
        boxShadow: '0 10px 30px rgba(15,23,42,0.08)',
        border: '1px solid #e5e7eb'
      }}
    >
      <div
        style={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          marginBottom: 16
        }}
      >
        <div>
          <h2 style={{ marginTop: 0, marginBottom: 4 }}>Manajemen User Aplikasi</h2>
          <p style={{ margin: 0, fontSize: 13, color: '#6b7280' }}>
            Tambah dan atur hak akses user untuk modul SIMRS web (pendaftaran, dokter, farmasi, kasir, admin).
          </p>
        </div>
        <button
          onClick={loadUsers}
          disabled={loading}
          style={{
            padding: '8px 12px',
            borderRadius: 999,
            border: 'none',
            background: loading ? '#9ca3af' : '#2563eb',
            color: '#fff',
            cursor: loading ? 'default' : 'pointer',
            fontSize: 12,
            fontWeight: 500
          }}
        >
          {loading ? 'Memuat…' : 'Refresh'}
        </button>
      </div>

      {error && (
        <div
          style={{
            marginBottom: 12,
            padding: 10,
            borderRadius: 8,
            background: '#fef2f2',
            color: '#b91c1c',
            fontSize: 13
          }}
        >
          {error}
        </div>
      )}

      <form
        onSubmit={handleCreate}
        style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fit, minmax(160px, 1fr))',
          gap: 8,
          alignItems: 'flex-end',
          marginBottom: 16,
          padding: 12,
          borderRadius: 12,
          border: '1px solid #e5e7eb',
          background: '#f9fafb',
          fontSize: 13
        }}
      >
        <div>
          <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Username</label>
          <input
            type="text"
            value={newUsername}
            onChange={(e) => setNewUsername(e.target.value)}
            style={{
              width: '100%',
              padding: '6px 8px',
              borderRadius: 8,
              border: '1px solid #d1d5db',
              fontSize: 13
            }}
          />
        </div>
        <div>
          <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Nama Lengkap</label>
          <input
            type="text"
            value={newFullName}
            onChange={(e) => setNewFullName(e.target.value)}
            style={{
              width: '100%',
              padding: '6px 8px',
              borderRadius: 8,
              border: '1px solid #d1d5db',
              fontSize: 13
            }}
          />
        </div>
        <div>
          <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Password</label>
          <input
            type="password"
            value={newPassword}
            onChange={(e) => setNewPassword(e.target.value)}
            style={{
              width: '100%',
              padding: '6px 8px',
              borderRadius: 8,
              border: '1px solid #d1d5db',
              fontSize: 13
            }}
          />
        </div>
        <div>
          <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Role</label>
          <select
            value={newRole}
            onChange={(e) => setNewRole(e.target.value as AppUser['role'])}
            style={{
              width: '100%',
              padding: '6px 8px',
              borderRadius: 8,
              border: '1px solid #d1d5db',
              fontSize: 13
            }}
          >
            <option value="pendaftaran">Pendaftaran</option>
            <option value="dokter">Dokter</option>
            <option value="farmasi">Farmasi</option>
            <option value="kasir">Kasir</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div>
          <button
            type="submit"
            disabled={creating}
            style={{
              width: '100%',
              padding: '8px 10px',
              borderRadius: 999,
              border: 'none',
              background: creating ? '#9ca3af' : '#16a34a',
              color: '#fff',
              cursor: creating ? 'default' : 'pointer',
              fontSize: 13,
              fontWeight: 500
            }}
          >
            {creating ? 'Menyimpan…' : 'Tambah User'}
          </button>
        </div>
      </form>

      <div
        style={{
          borderRadius: 12,
          border: '1px solid #e5e7eb',
          overflow: 'hidden',
          fontSize: 13
        }}
      >
        <table
          style={{
            width: '100%',
            borderCollapse: 'collapse',
            fontSize: 12
          }}
        >
          <thead>
            <tr style={{ background: '#f3f4f6' }}>
              <th style={{ padding: '6px 8px', textAlign: 'left' }}>Username</th>
              <th style={{ padding: '6px 8px', textAlign: 'left' }}>Nama Lengkap</th>
              <th style={{ padding: '6px 8px', textAlign: 'left' }}>Role</th>
              <th style={{ padding: '6px 8px', textAlign: 'left' }}>Status</th>
              <th style={{ padding: '6px 8px', textAlign: 'left' }}>Aksi</th>
            </tr>
          </thead>
          <tbody>
            {users.map((u) => (
              <tr key={u.id}>
                <td style={{ padding: '4px 8px', borderTop: '1px solid #e5e7eb' }}>{u.username}</td>
                <td style={{ padding: '4px 8px', borderTop: '1px solid #e5e7eb' }}>
                  <input
                    type="text"
                    value={u.full_name}
                    onChange={(e) =>
                      setUsers((prev) =>
                        prev.map((x) =>
                          x.id === u.id
                            ? {
                                ...x,
                                full_name: e.target.value
                              }
                            : x
                        )
                      )
                    }
                    style={{
                      width: '100%',
                      padding: '4px 6px',
                      borderRadius: 6,
                      border: '1px solid #d1d5db',
                      fontSize: 12
                    }}
                  />
                </td>
                <td style={{ padding: '4px 8px', borderTop: '1px solid #e5e7eb' }}>
                  <select
                    value={u.role}
                    onChange={(e) => handleRoleChange(u.id, e.target.value as AppUser['role'])}
                    style={{
                      width: '100%',
                      padding: '4px 6px',
                      borderRadius: 6,
                      border: '1px solid #d1d5db',
                      fontSize: 12
                    }}
                  >
                    <option value="pendaftaran">Pendaftaran</option>
                    <option value="dokter">Dokter</option>
                    <option value="farmasi">Farmasi</option>
                    <option value="kasir">Kasir</option>
                    <option value="admin">Admin</option>
                  </select>
                </td>
                <td style={{ padding: '4px 8px', borderTop: '1px solid #e5e7eb' }}>
                  <label style={{ display: 'inline-flex', alignItems: 'center', gap: 4, fontSize: 11 }}>
                    <input
                      type="checkbox"
                      checked={u.is_active ?? true}
                      onChange={(e) => handleToggleActive(u.id, e.target.checked)}
                    />
                    {u.is_active ?? true ? 'Aktif' : 'Nonaktif'}
                  </label>
                </td>
                <td style={{ padding: '4px 8px', borderTop: '1px solid #e5e7eb' }}>
                  <button
                    onClick={() => void handleUpdate(u)}
                    disabled={savingId === u.id}
                    style={{
                      padding: '4px 8px',
                      borderRadius: 999,
                      border: 'none',
                      background: savingId === u.id ? '#9ca3af' : '#2563eb',
                      color: '#fff',
                      cursor: savingId === u.id ? 'default' : 'pointer',
                      fontSize: 11,
                      marginRight: 4
                    }}
                  >
                    Simpan
                  </button>
                  <button
                    onClick={() => void handleResetPassword(u)}
                    disabled={savingId === u.id}
                    style={{
                      padding: '4px 8px',
                      borderRadius: 999,
                      border: 'none',
                      background: '#f97316',
                      color: '#fff',
                      cursor: savingId === u.id ? 'default' : 'pointer',
                      fontSize: 11
                    }}
                  >
                    Reset PW
                  </button>
                </td>
              </tr>
            ))}
            {users.length === 0 && (
              <tr>
                <td
                  colSpan={5}
                  style={{
                    padding: '8px 8px',
                    textAlign: 'center',
                    color: '#9ca3af',
                    borderTop: '1px solid #e5e7eb'
                  }}
                >
                  Belum ada user lain selain admin default.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </section>
  );
};
const PendaftaranView: React.FC = () => {
  const [poli, setPoli] = React.useState<Poli[]>([]);
  const [dokter, setDokter] = React.useState<Dokter[]>([]);
  const [penjab, setPenjab] = React.useState<Penjab[]>([]);
  const [regToday, setRegToday] = React.useState<RegToday[]>([]);
  const [loading, setLoading] = React.useState<boolean>(false);
  const [error, setError] = React.useState<string | null>(null);

  const [noRkmMedis, setNoRkmMedis] = React.useState<string>('');
  const [selectedPoli, setSelectedPoli] = React.useState<string>('');
  const [selectedDokter, setSelectedDokter] = React.useState<string>('');
  const [kdPj, setKdPj] = React.useState<string>(''); // akan di-set otomatis setelah load penjab
  const [saving, setSaving] = React.useState<boolean>(false);
  const [info, setInfo] = React.useState<string | null>(null);

  const [patient, setPatient] = React.useState<PatientBrief | null>(null);
  const [patientLoading, setPatientLoading] = React.useState<boolean>(false);
  const [patientError, setPatientError] = React.useState<string | null>(null);

  const [filterPoli, setFilterPoli] = React.useState<string>('');
  const [filterDokter, setFilterDokter] = React.useState<string>('');
  const [searchText, setSearchText] = React.useState<string>('');

  const loadData = async () => {
    setLoading(true);
    setError(null);
    try {
      const [poliRes, dokterRes, penjabRes, regRes] = await Promise.all([
        fetch('/api/pendaftaran/poli'),
        fetch('/api/pendaftaran/dokter'),
        fetch('/api/pendaftaran/penjab'),
        fetch('/api/pendaftaran/today')
      ]);

      if (!poliRes.ok || !dokterRes.ok || !penjabRes.ok || !regRes.ok) {
        throw new Error('Gagal mengambil data pendaftaran');
      }

      const [poliJson, dokterJson, penjabJson, regJson] = await Promise.all([
        poliRes.json(),
        dokterRes.json(),
        penjabRes.json(),
        regRes.json()
      ]);

      // Antisipasi jika backend mengirim null (slice kosong di Go -> null dalam JSON),
      // kita paksa menjadi array kosong agar tidak error saat .length / .map.
      const poliData: Poli[] = Array.isArray(poliJson) ? poliJson : [];
      const dokterData: Dokter[] = Array.isArray(dokterJson) ? dokterJson : [];
      const penjabData: Penjab[] = Array.isArray(penjabJson) ? penjabJson : [];
      const regData: RegToday[] = Array.isArray(regJson) ? regJson : [];

      setPoli(poliData);
      setDokter(dokterData);
      setPenjab(penjabData);
      setRegToday(regData);

      // jika kdPj belum diset dan ada data penjab, pilih yang pertama sebagai default
      if (!kdPj && penjabData.length > 0) {
        setKdPj(penjabData[0].kd_pj);
      }
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan');
    } finally {
      setLoading(false);
    }
  };

  React.useEffect(() => {
    void loadData();
  }, []);

  const fetchPatient = async (no: string) => {
    setPatient(null);
    setPatientError(null);
    if (!no) {
      return;
    }
    setPatientLoading(true);
    try {
      const res = await fetch(`/api/pendaftaran/pasien/${encodeURIComponent(no)}`);
      if (res.status === 404) {
        setPatientError('Pasien tidak ditemukan di tabel pasien.');
        return;
      }
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error((data as any).error || 'Gagal mengambil data pasien');
      }
      const data: PatientBrief = await res.json();
      setPatient(data);
    } catch (e) {
      setPatientError(e instanceof Error ? e.message : 'Terjadi kesalahan saat mengambil pasien');
    } finally {
      setPatientLoading(false);
    }
  };

  const filteredRegToday = React.useMemo(() => {
    const search = searchText.trim().toLowerCase();
    return regToday.filter((r) => {
      if (filterPoli && r.kd_poli !== filterPoli) return false;
      if (filterDokter && r.kd_dokter !== filterDokter) return false;
      if (search) {
        const haystack = `${r.no_rkm_medis} ${r.nm_pasien}`.toLowerCase();
        if (!haystack.includes(search)) return false;
      }
      return true;
    });
  }, [regToday, filterPoli, filterDokter, searchText]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    setInfo(null);

    if (!noRkmMedis || !selectedPoli || !selectedDokter || !kdPj) {
      setError('Lengkapi No. RM, Poli, Dokter, dan Cara Bayar.');
      return;
    }

    if (!patient) {
      setError('No. RM belum valid / pasien belum ditemukan. Mohon cek data pasien dahulu.');
      return;
    }

    setSaving(true);
    try {
      const res = await fetch('/api/pendaftaran/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          no_rkm_medis: noRkmMedis,
          kd_poli: selectedPoli,
          kd_dokter: selectedDokter,
          kd_pj: kdPj
        })
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Gagal menyimpan pendaftaran');
      }

      setInfo(`Pendaftaran berhasil. No. Rawat: ${data.no_rawat}, No. Reg: ${data.no_reg}`);
      setNoRkmMedis('');
      setSelectedPoli('');
      setSelectedDokter('');

      // refresh daftar pendaftaran hari ini
      await loadData();
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan saat simpan');
    } finally {
      setSaving(false);
    }
  };

  return (
    <section
      style={{
        background: '#ffffff',
        borderRadius: 16,
        padding: 24,
        boxShadow: '0 10px 30px rgba(15,23,42,0.08)',
        border: '1px solid #e5e7eb'
      }}
    >
      <div
        style={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          marginBottom: 16
        }}
      >
        <div>
          <h2 style={{ marginTop: 0, marginBottom: 4 }}>Pendaftaran Rawat Jalan</h2>
          <p style={{ margin: 0, color: '#6b7280', fontSize: 13 }}>
            Data poli, dokter, dan daftar pendaftaran hari ini yang diambil langsung dari database
            <code> ibnusinadev</code>.
          </p>
        </div>
        <button
          onClick={loadData}
          disabled={loading}
          style={{
            padding: '8px 12px',
            borderRadius: 999,
            border: 'none',
            background: loading ? '#9ca3af' : '#16a34a',
            color: '#fff',
            cursor: loading ? 'default' : 'pointer',
            fontSize: 12,
            fontWeight: 500
          }}
        >
          {loading ? 'Memuat…' : 'Refresh Data'}
        </button>
      </div>

      {error && (
        <div
          style={{
            marginBottom: 16,
            padding: 10,
            borderRadius: 8,
            background: '#fef2f2',
            color: '#b91c1c',
            fontSize: 13
          }}
        >
          {error}
        </div>
      )}

      <form
        onSubmit={handleSubmit}
        style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))',
          gap: 16,
          alignItems: 'flex-start',
          marginBottom: 16,
          padding: 16,
          borderRadius: 12,
          border: '1px solid #e5e7eb',
          background: '#f9fafb',
          fontSize: 13
        }}
      >
        <div>
          <h3 style={{ marginTop: 0, marginBottom: 8, fontSize: 14 }}>Input Pendaftaran Baru</h3>
          <div style={{ marginBottom: 8 }}>
            <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>No. Rekam Medis</label>
            <input
              type="text"
              value={noRkmMedis}
              onChange={(e) => {
                setNoRkmMedis(e.target.value);
              }}
              onBlur={() => {
                void fetchPatient(noRkmMedis.trim());
              }}
              placeholder="Contoh: 000001"
              style={{
                width: '100%',
                padding: '6px 8px',
                borderRadius: 8,
                border: '1px solid #d1d5db',
                fontSize: 13
              }}
            />
          </div>
          <div style={{ marginBottom: 8 }}>
            <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Poliklinik</label>
            <select
              value={selectedPoli}
              onChange={(e) => setSelectedPoli(e.target.value)}
              style={{
                width: '100%',
                padding: '6px 8px',
                borderRadius: 8,
                border: '1px solid #d1d5db',
                fontSize: 13
              }}
            >
              <option value="">Pilih Poli</option>
              {poli.map((p) => (
                <option key={p.kd_poli} value={p.kd_poli}>
                  {p.nm_poli}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div>
          <h3 style={{ marginTop: 0, marginBottom: 8, fontSize: 14, visibility: 'hidden' }}>.</h3>
          <div style={{ marginBottom: 8 }}>
            <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Dokter</label>
            <select
              value={selectedDokter}
              onChange={(e) => setSelectedDokter(e.target.value)}
              style={{
                width: '100%',
                padding: '6px 8px',
                borderRadius: 8,
                border: '1px solid #d1d5db',
                fontSize: 13
              }}
            >
              <option value="">Pilih Dokter</option>
              {dokter.map((d) => (
                <option key={d.kd_dokter} value={d.kd_dokter}>
                  {d.nm_dokter}
                </option>
              ))}
            </select>
          </div>
          <div style={{ marginBottom: 8 }}>
            <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Cara Bayar / Penjamin</label>
            <select
              value={kdPj}
              onChange={(e) => setKdPj(e.target.value)}
              style={{
                width: '100%',
                padding: '6px 8px',
                borderRadius: 8,
                border: '1px solid #d1d5db',
                fontSize: 13
              }}
            >
              <option value="">Pilih Cara Bayar</option>
              {penjab.map((p) => (
                <option key={p.kd_pj} value={p.kd_pj}>
                  {p.nm_pj} ({p.kd_pj})
                </option>
              ))}
            </select>
          </div>
          <button
            type="submit"
            disabled={saving}
            style={{
              marginTop: 4,
              padding: '8px 14px',
              borderRadius: 999,
              border: 'none',
              background: saving ? '#9ca3af' : '#16a34a',
              color: '#fff',
              cursor: saving ? 'default' : 'pointer',
              fontSize: 13,
              fontWeight: 500
            }}
          >
            {saving ? 'Menyimpan…' : 'Simpan Pendaftaran'}
          </button>
        </div>
      </form>

      {info && (
        <div
          style={{
            marginBottom: 12,
            padding: 10,
            borderRadius: 8,
            background: '#ecfdf3',
            color: '#166534',
            fontSize: 13
          }}
        >
          {info}
        </div>
      )}

      {/* Info pasien singkat */}
      <div
        style={{
          marginBottom: 12,
          padding: 12,
          borderRadius: 12,
          border: '1px solid #e5e7eb',
          background: '#f9fafb',
          fontSize: 13
        }}
      >
        <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 4 }}>
          <strong>Data Pasien</strong>
          {patientLoading && <span style={{ fontSize: 11, color: '#6b7280' }}>Memuat data pasien…</span>}
        </div>
        {patient ? (
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(160px, 1fr))', gap: 8 }}>
            <div>
              <div style={{ fontSize: 11, color: '#6b7280' }}>No. RM</div>
              <div>{patient.no_rkm_medis}</div>
            </div>
            <div>
              <div style={{ fontSize: 11, color: '#6b7280' }}>Nama</div>
              <div>{patient.nm_pasien}</div>
            </div>
            <div>
              <div style={{ fontSize: 11, color: '#6b7280' }}>JK / Tgl Lahir</div>
              <div>
                {patient.jk} / {patient.tgl_lahir}
              </div>
            </div>
            <div style={{ gridColumn: '1 / -1' }}>
              <div style={{ fontSize: 11, color: '#6b7280' }}>Alamat</div>
              <div>{patient.alamat}</div>
            </div>
          </div>
        ) : patientError ? (
          <div style={{ fontSize: 12, color: '#b91c1c' }}>{patientError}</div>
        ) : (
          <div style={{ fontSize: 12, color: '#9ca3af' }}>Isi No. RM kemudian keluar dari kolom untuk melihat data pasien.</div>
        )}
      </div>

      <div
        style={{
          display: 'grid',
          gridTemplateColumns: 'minmax(0, 260px) minmax(0, 1fr)',
          gap: 16,
          alignItems: 'flex-start'
        }}
      >
        {/* Panel referensi poli & dokter */}
        <div
          style={{
            borderRadius: 12,
            border: '1px solid #e5e7eb',
            padding: 14,
            background: '#f9fafb',
            fontSize: 13
          }}
        >
          <h3 style={{ marginTop: 0, marginBottom: 8, fontSize: 14 }}>Referensi Poli</h3>
          <div
            style={{
              maxHeight: 180,
              overflowY: 'auto',
              borderRadius: 8,
              border: '1px solid #e5e7eb',
              background: '#fff'
            }}
          >
            <table
              style={{
                width: '100%',
                borderCollapse: 'collapse',
                fontSize: 12
              }}
            >
              <thead>
                <tr style={{ background: '#f3f4f6' }}>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Kode</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Poliklinik</th>
                </tr>
              </thead>
              <tbody>
                {poli.map((p) => (
                  <tr key={p.kd_poli}>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{p.kd_poli}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{p.nm_poli}</td>
                  </tr>
                ))}
                {poli.length === 0 && (
                  <tr>
                    <td
                      colSpan={2}
                      style={{
                        padding: '6px 8px',
                        textAlign: 'center',
                        color: '#9ca3af'
                      }}
                    >
                      Tidak ada data poli
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          <h3 style={{ marginTop: 16, marginBottom: 8, fontSize: 14 }}>Referensi Dokter</h3>
          <div
            style={{
              maxHeight: 180,
              overflowY: 'auto',
              borderRadius: 8,
              border: '1px solid #e5e7eb',
              background: '#fff'
            }}
          >
            <table
              style={{
                width: '100%',
                borderCollapse: 'collapse',
                fontSize: 12
              }}
            >
              <thead>
                <tr style={{ background: '#f3f4f6' }}>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Kode</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Nama</th>
                </tr>
              </thead>
              <tbody>
                {dokter.map((d) => (
                  <tr key={d.kd_dokter}>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{d.kd_dokter}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{d.nm_dokter}</td>
                  </tr>
                ))}
                {dokter.length === 0 && (
                  <tr>
                    <td
                      colSpan={2}
                      style={{
                        padding: '6px 8px',
                        textAlign: 'center',
                        color: '#9ca3af'
                      }}
                    >
                      Tidak ada data dokter
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

        {/* Tabel pendaftaran hari ini */}
        <div
          style={{
            borderRadius: 12,
            border: '1px solid #e5e7eb',
            padding: 14,
            background: '#f9fafb',
            fontSize: 13
          }}
        >
          <div
            style={{
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              marginBottom: 8,
              gap: 12,
              flexWrap: 'wrap'
            }}
          >
            <h3 style={{ margin: 0, fontSize: 14 }}>Daftar Pendaftaran Hari Ini</h3>
            <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
              <select
                value={filterPoli}
                onChange={(e) => setFilterPoli(e.target.value)}
                style={{
                  padding: '4px 8px',
                  borderRadius: 999,
                  border: '1px solid #d1d5db',
                  fontSize: 11,
                  background: '#fff'
                }}
              >
                <option value="">Semua Poli</option>
                {poli.map((p) => (
                  <option key={p.kd_poli} value={p.kd_poli}>
                    {p.nm_poli}
                  </option>
                ))}
              </select>
              <select
                value={filterDokter}
                onChange={(e) => setFilterDokter(e.target.value)}
                style={{
                  padding: '4px 8px',
                  borderRadius: 999,
                  border: '1px solid #d1d5db',
                  fontSize: 11,
                  background: '#fff'
                }}
              >
                <option value="">Semua Dokter</option>
                {dokter.map((d) => (
                  <option key={d.kd_dokter} value={d.kd_dokter}>
                    {d.nm_dokter}
                  </option>
                ))}
              </select>
              <input
                type="text"
                value={searchText}
                onChange={(e) => setSearchText(e.target.value)}
                placeholder="Cari No. RM / Nama"
                style={{
                  padding: '4px 8px',
                  borderRadius: 999,
                  border: '1px solid #d1d5db',
                  fontSize: 11,
                  minWidth: 140
                }}
              />
              <span style={{ fontSize: 11, color: '#6b7280' }}>
                Total: <strong>{filteredRegToday.length}</strong> kunjungan
              </span>
            </div>
          </div>

          <div
            style={{
              maxHeight: 360,
              overflow: 'auto',
              borderRadius: 8,
              border: '1px solid #e5e7eb',
              background: '#fff'
            }}
          >
            <table
              style={{
                width: '100%',
                borderCollapse: 'collapse',
                fontSize: 12
              }}
            >
              <thead>
                <tr style={{ background: '#f3f4f6' }}>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>No. Rawat</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>No. RM</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Nama Pasien</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Jam</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Poli</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Dokter</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Status</th>
                </tr>
              </thead>
              <tbody>
                {filteredRegToday.map((r) => (
                  <tr key={r.no_rawat}>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6', whiteSpace: 'nowrap' }}>
                      {r.no_rawat}
                    </td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{r.no_rkm_medis}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{r.nm_pasien}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{r.jam_reg}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{r.nm_poli}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{r.nm_dokter}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>
                      <span
                        style={{
                          padding: '2px 8px',
                          borderRadius: 999,
                          background:
                            r.status_lanjut === 'Ralan'
                              ? '#ecfdf3'
                              : r.status_lanjut === 'Ranap'
                              ? '#eff6ff'
                              : '#fefce8',
                          color:
                            r.status_lanjut === 'Ralan'
                              ? '#166534'
                              : r.status_lanjut === 'Ranap'
                              ? '#1d4ed8'
                              : '#92400e',
                          fontSize: 11
                        }}
                      >
                        {r.status_lanjut} / {r.stts}
                      </span>
                    </td>
                  </tr>
                ))}
                {filteredRegToday.length === 0 && (
                  <tr>
                    <td
                      colSpan={7}
                      style={{
                        padding: '8px 8px',
                        textAlign: 'center',
                        color: '#9ca3af'
                      }}
                    >
                      Belum ada pendaftaran untuk hari ini atau data tidak ditemukan.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  );
};

export const App: React.FC = () => {
  const [user, setUser] = React.useState<AppUser | null>(null);
  const [activeMenu, setActiveMenu] = React.useState<MenuKey>('dashboard');
  const [health, setHealth] = React.useState<string>('Belum cek');
  const [loadingHealth, setLoadingHealth] = React.useState<boolean>(false);

  const menuItems: { key: MenuKey; label: string }[] = [
    { key: 'dashboard', label: 'Dashboard' },
    { key: 'pendaftaran', label: 'Pendaftaran' },
    { key: 'igd', label: 'IGD' },
    { key: 'rawat-jalan', label: 'Rawat Jalan' },
    { key: 'rawat-inap', label: 'Rawat Inap' },
    { key: 'farmasi', label: 'Farmasi' },
    { key: 'kasir', label: 'Kasir' },
    { key: 'laporan', label: 'Laporan' },
    { key: 'admin', label: 'Admin' }
  ];

  const checkBackend = async () => {
    setLoadingHealth(true);
    try {
      const res = await fetch('/api/health');
      const data = await res.json();
      setHealth(`Status: ${data.status}, DB: ${data.db}`);
    } catch (e) {
      setHealth('Gagal konek ke backend');
    } finally {
      setLoadingHealth(false);
    }
  };

  React.useEffect(() => {
    void checkBackend();
  }, []);

  React.useEffect(() => {
    const stored = window.localStorage.getItem('ermapp_user');
    if (stored) {
      try {
        const parsed = JSON.parse(stored) as AppUser;
        setUser(parsed);
      } catch {
        window.localStorage.removeItem('ermapp_user');
      }
    }
  }, []);

  const handleLogin = (u: AppUser) => {
    setUser(u);
    window.localStorage.setItem('ermapp_user', JSON.stringify(u));
  };

  const handleLogout = () => {
    setUser(null);
    window.localStorage.removeItem('ermapp_user');
  };

  const canAccessMenu = (menu: MenuKey, role: AppUser['role']) => {
    switch (role) {
      case 'pendaftaran':
        return menu === 'dashboard' || menu === 'pendaftaran';
      case 'dokter':
        return menu === 'dashboard' || menu === 'rawat-jalan' || menu === 'rawat-inap' || menu === 'laporan';
      case 'farmasi':
        return menu === 'dashboard' || menu === 'farmasi' || menu === 'laporan';
      case 'kasir':
        return menu === 'dashboard' || menu === 'kasir' || menu === 'laporan';
      case 'admin':
      default:
        return true;
    }
  };

  if (!user) {
    return <LoginView onLogin={handleLogin} />;
  }

  const visibleMenuItems = menuItems.filter((m) => canAccessMenu(m.key, user.role));

  const renderContent = () => {
    switch (activeMenu) {
      case 'dashboard':
        return (
          <section
            style={{
              background: '#ffffff',
              borderRadius: 16,
              padding: 24,
              boxShadow: '0 10px 30px rgba(15,23,42,0.08)',
              border: '1px solid #e5e7eb'
            }}
          >
            <h2 style={{ marginTop: 0, marginBottom: 4 }}>Dashboard</h2>
            <p style={{ marginTop: 0, marginBottom: 16, color: '#6b7280' }}>
              Ringkasan status sistem dan koneksi service utama.
            </p>

            <div
              style={{
                display: 'grid',
                gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))',
                gap: 16
              }}
            >
              <div
                style={{
                  padding: 16,
                  borderRadius: 12,
                  background:
                    'linear-gradient(135deg, rgba(37,99,235,0.06), rgba(59,130,246,0.12))',
                  border: '1px solid rgba(37,99,235,0.18)'
                }}
              >
                <h3 style={{ marginTop: 0, marginBottom: 8, fontSize: 14, color: '#1d4ed8' }}>
                  Status Backend & Database
                </h3>
                <p style={{ margin: 0, fontSize: 13 }}>
                  <strong>Hasil:</strong> {health}
                </p>
                <button
                  onClick={checkBackend}
                  disabled={loadingHealth}
                  style={{
                    marginTop: 12,
                    padding: '6px 12px',
                    borderRadius: 999,
                    border: 'none',
                    background: loadingHealth ? '#9ca3af' : '#2563eb',
                    color: '#fff',
                    cursor: loadingHealth ? 'default' : 'pointer',
                    fontSize: 12,
                    fontWeight: 500
                  }}
                >
                  {loadingHealth ? 'Mengecek…' : 'Cek Ulang'}
                </button>
              </div>

              <div
                style={{
                  padding: 16,
                  borderRadius: 12,
                  background: '#f9fafb',
                  border: '1px dashed #e5e7eb',
                  fontSize: 13,
                  color: '#4b5563'
                }}
              >
                <strong>Informasi Sistem</strong>
                <ul style={{ marginTop: 8, paddingLeft: 18 }}>
                  <li>Arsitektur: Backend Go + Frontend React + DB MySQL (`ibnusinadev`).</li>
                  <li>
                    Layout ini dirancang untuk dikembangkan menjadi modul: pendaftaran, IGD, rawat jalan,
                    rawat inap, farmasi, kasir, laporan, dan admin.
                  </li>
                </ul>
              </div>
            </div>
          </section>
        );
      case 'pendaftaran':
        return <PendaftaranView />;
      case 'igd':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>IGD</h2>
            <p style={{ color: '#6b7280' }}>Monitoring pasien IGD, triase, dan tindakan emergensi.</p>
          </section>
        );
      case 'rawat-jalan':
        return <RawatJalanView />;
      case 'rawat-inap':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Rawat Inap</h2>
            <p style={{ color: '#6b7280' }}>Manajemen bed, DPJP, order, dan catatan perawatan.</p>
          </section>
        );
      case 'farmasi':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Farmasi</h2>
            <p style={{ color: '#6b7280' }}>Pengelolaan stok obat, resep, dan distribusi ke unit.</p>
          </section>
        );
      case 'kasir':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Kasir</h2>
            <p style={{ color: '#6b7280' }}>Billing pasien, pembayaran, dan rekapitulasi kas harian.</p>
          </section>
        );
      case 'laporan':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Laporan</h2>
            <p style={{ color: '#6b7280' }}>
              Laporan kunjungan, BOR, LOS, pendapatan, dan pelaporan ke dinas/BPJS.
            </p>
          </section>
        );
      case 'admin':
        return <AdminUsersView />;
      default:
        return null;
    }
  };

  return (
    <div
      style={{
        fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        background: 'radial-gradient(circle at top left, #eff6ff 0, #f9fafb 45%, #eef2ff 100%)',
        minHeight: '100vh',
        display: 'flex'
      }}
    >
      {/* Sidebar */}
      <aside
        style={{
          width: 260,
          background: 'rgba(15,23,42,0.96)',
          color: '#e5e7eb',
          display: 'flex',
          flexDirection: 'column',
          padding: '16px 14px',
          boxShadow: '4px 0 18px rgba(15,23,42,0.35)',
          position: 'sticky',
          top: 0,
          height: '100vh'
        }}
      >
        <div style={{ padding: '10px 10px 20px 10px', borderBottom: '1px solid rgba(148,163,184,0.2)' }}>
          <div style={{ fontSize: 14, fontWeight: 600, letterSpacing: 0.4, color: '#93c5fd' }}>
            SIMRS WEB
          </div>
          <div style={{ fontSize: 13, color: '#cbd5f5' }}>Khanza → Go + React</div>
        </div>

        <nav style={{ marginTop: 16, flex: 1, overflowY: 'auto' }}>
          {visibleMenuItems.map((item) => {
            const active = activeMenu === item.key;
            return (
              <button
                key={item.key}
                onClick={() => setActiveMenu(item.key)}
                style={{
                  width: '100%',
                  textAlign: 'left',
                  padding: '8px 10px',
                  marginBottom: 4,
                  borderRadius: 10,
                  border: 'none',
                  background: active ? 'rgba(59,130,246,0.18)' : 'transparent',
                  color: active ? '#eff6ff' : '#e5e7eb',
                  cursor: 'pointer',
                  fontSize: 13,
                  fontWeight: active ? 600 : 400,
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center'
                }}
              >
                <span>{item.label}</span>
                {active && (
                  <span
                    style={{
                      width: 6,
                      height: 6,
                      borderRadius: '999px',
                      background: '#60a5fa'
                    }}
                  />
                )}
              </button>
            );
          })}
        </nav>

        <div
          style={{
            marginTop: 8,
            padding: '10px 10px 6px 10px',
            borderTop: '1px solid rgba(148,163,184,0.2)',
            fontSize: 11,
            color: '#9ca3af'
          }}
        >
          <div>Rumah Sakit: <strong>Contoh RS</strong></div>
          <div>Versi: 0.0.1 (layout awal)</div>
        </div>
      </aside>

      {/* Main area */}
      <div style={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
        {/* Topbar */}
        <header
          style={{
            height: 64,
            padding: '12px 24px',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            borderBottom: '1px solid #e5e7eb',
            backdropFilter: 'blur(18px)',
            background: 'rgba(249,250,251,0.82)',
            position: 'sticky',
            top: 0,
            zIndex: 10
          }}
        >
          <div>
            <div style={{ fontSize: 18, fontWeight: 600, color: '#111827' }}>
              {visibleMenuItems.find((m) => m.key === activeMenu)?.label}
            </div>
            <div style={{ fontSize: 12, color: '#6b7280' }}>
              Modul SIMRS: {visibleMenuItems.find((m) => m.key === activeMenu)?.label}
            </div>
          </div>

          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 12,
              fontSize: 13,
              color: '#4b5563'
            }}
          >
            <span
              style={{
                padding: '4px 8px',
                borderRadius: 999,
                background: '#e0f2fe',
                color: '#0369a1',
                fontSize: 11,
                fontWeight: 600
              }}
            >
              ENV: DEV
            </span>
            <div
              style={{
                width: 32,
                height: 32,
                borderRadius: '999px',
                background:
                  'linear-gradient(135deg, #2563eb, #4f46e5)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                color: '#e5e7eb',
                fontSize: 13,
                fontWeight: 600
              }}
            >
              {user.full_name
                .split(' ')
                .map((p) => p.charAt(0))
                .join('')
                .slice(0, 2)
                .toUpperCase()}
            </div>
            <button
              onClick={handleLogout}
              style={{
                padding: '4px 10px',
                borderRadius: 999,
                border: '1px solid #e5e7eb',
                background: '#ffffff',
                fontSize: 11,
                cursor: 'pointer'
              }}
            >
              Keluar
            </button>
          </div>
        </header>

        {/* Content */}
        <main
          style={{
            padding: 24,
            minHeight: 'calc(100vh - 64px)',
            boxSizing: 'border-box'
          }}
        >
          {renderContent()}
        </main>
      </div>
    </div>
  );
};


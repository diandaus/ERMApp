};

const AdminUsersView: React.FC = () => {
  const [users, setUsers] = React.useState<AppUser[]>([]);
  const [loading, setLoading] = React.useState<boolean>(false);
  const [error, setError] = React.useState<string | null>(null);
  const [savingId, setSavingId] = React.useState<number | null>(null);
  const [creating, setCreating] = React.useState<boolean>(false);

  const [newUsername, setNewUsername] = React.useState<string>('');
  const [newFullName, setNewFullName] = React.useState<string>('');
  const [newPassword, setNewPassword] = React.useState<string>('');
  const [newRole, setNewRole] = React.useState<AppUser['role']>('pendaftaran');

  const loadUsers = async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch('/api/admin/users');
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Gagal mengambil data user');
      }
      setUsers(data as AppUser[]);
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan');
    } finally {
      setLoading(false);
    }
  };

  React.useEffect(() => {
    void loadUsers();
  }, []);

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    if (!newUsername || !newFullName || !newPassword || !newRole) {
      setError('Lengkapi username, nama lengkap, password, dan role.');
      return;
    }
    setCreating(true);
    try {
      const res = await fetch('/api/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: newUsername,
          password: newPassword,
          full_name: newFullName,
          role: newRole
        })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error((data as any).error || 'Gagal membuat user');
      }
      setNewUsername('');
      setNewFullName('');
      setNewPassword('');
      setNewRole('pendaftaran');
      await loadUsers();
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan saat membuat user');
    } finally {
      setCreating(false);
    }
  };

  const handleUpdate = async (u: AppUser) => {
    setSavingId(u.id);
    setError(null);
    try {
      const res = await fetch(`/api/admin/users/${u.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          full_name: u.full_name,
          role: u.role,
          is_active: u.is_active ?? true
        })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error((data as any).error || 'Gagal menyimpan perubahan user');
      }
      await loadUsers();
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan saat menyimpan user');
    } finally {
      setSavingId(null);
    }
  };

  const handleResetPassword = async (u: AppUser) => {
    const confirmReset = window.confirm(
      `Reset password user "${u.username}" ke nilai default "123456"?`
    );
    if (!confirmReset) return;
    setSavingId(u.id);
    setError(null);
    try {
      const res = await fetch(`/api/admin/users/${u.id}/reset-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: '123456' })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error((data as any).error || 'Gagal reset password');
      }
      alert(`Password user "${u.username}" telah direset ke: 123456`);
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan saat reset password');
    } finally {
      setSavingId(null);
    }
  };

  const handleToggleActive = (id: number, value: boolean) => {
    setUsers((prev) =>
      prev.map((u) =>
        u.id === id
          ? {
              ...u,
              is_active: value
            }
          : u
      )
    );
  };

  const handleRoleChange = (id: number, role: AppUser['role']) => {
    setUsers((prev) =>
      prev.map((u) =>
        u.id === id
          ? {
              ...u,
              role
            }
          : u
      )
    );
  };

  return (
    <section
      style={{
        background: '#ffffff',
        borderRadius: 16,
        padding: 24,
        boxShadow: '0 10px 30px rgba(15,23,42,0.08)',
        border: '1px solid #e5e7eb'
      }}
    >
      <div
        style={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          marginBottom: 16
        }}
      >
        <div>
          <h2 style={{ marginTop: 0, marginBottom: 4 }}>Manajemen User Aplikasi</h2>
          <p style={{ margin: 0, fontSize: 13, color: '#6b7280' }}>
            Tambah dan atur hak akses user untuk modul SIMRS web (pendaftaran, dokter, farmasi, kasir, admin).
          </p>
        </div>
        <button
          onClick={loadUsers}
          disabled={loading}
          style={{
            padding: '8px 12px',
            borderRadius: 999,
            border: 'none',
            background: loading ? '#9ca3af' : '#1AB1E5',
            color: '#fff',
            cursor: loading ? 'default' : 'pointer',
            fontSize: 12,
            fontWeight: 500
          }}
        >
          {loading ? 'Memuat…' : 'Refresh'}
        </button>
      </div>

      {error && (
        <div
          style={{
            marginBottom: 12,
            padding: 10,
            borderRadius: 8,
            background: '#fef2f2',
            color: '#b91c1c',
            fontSize: 13
          }}
        >
          {error}
        </div>
      )}

      <form
        onSubmit={handleCreate}
        style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fit, minmax(160px, 1fr))',
          gap: 8,
          alignItems: 'flex-end',
          marginBottom: 16,
          padding: 12,
          borderRadius: 12,
          border: '1px solid #e5e7eb',
          background: '#f9fafb',
          fontSize: 13
        }}
      >
        <div>
          <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Username</label>
          <input
            type="text"
            value={newUsername}
            onChange={(e) => setNewUsername(e.target.value)}
            style={{
              width: '100%',
              padding: '6px 8px',
              borderRadius: 8,
              border: '1px solid #d1d5db',
              fontSize: 13
            }}
          />
        </div>
        <div>
          <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Nama Lengkap</label>
          <input
            type="text"
            value={newFullName}
            onChange={(e) => setNewFullName(e.target.value)}
            style={{
              width: '100%',
              padding: '6px 8px',
              borderRadius: 8,
              border: '1px solid #d1d5db',
              fontSize: 13
            }}
          />
        </div>
        <div>
          <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Password</label>
          <input
            type="password"
            value={newPassword}
            onChange={(e) => setNewPassword(e.target.value)}
            style={{
              width: '100%',
              padding: '6px 8px',
              borderRadius: 8,
              border: '1px solid #d1d5db',
              fontSize: 13
            }}
          />
        </div>
        <div>
          <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Role</label>
          <select
            value={newRole}
            onChange={(e) => setNewRole(e.target.value as AppUser['role'])}
            style={{
              width: '100%',
              padding: '6px 8px',
              borderRadius: 8,
              border: '1px solid #d1d5db',
              fontSize: 13
            }}
          >
            <option value="pendaftaran">Pendaftaran</option>
            <option value="dokter">Dokter</option>
            <option value="farmasi">Farmasi</option>
            <option value="kasir">Kasir</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div>
          <button
            type="submit"
            disabled={creating}
            style={{
              width: '100%',
              padding: '8px 10px',
              borderRadius: 999,
              border: 'none',
              background: creating ? '#9ca3af' : '#16a34a',
              color: '#fff',
              cursor: creating ? 'default' : 'pointer',
              fontSize: 13,
              fontWeight: 500
            }}
          >
            {creating ? 'Menyimpan…' : 'Tambah User'}
          </button>
        </div>
      </form>

      <div
        style={{
          borderRadius: 12,
          border: '1px solid #e5e7eb',
          overflow: 'hidden',
          fontSize: 13
        }}
      >
        <table
          style={{
            width: '100%',
            borderCollapse: 'collapse',
            fontSize: 12
          }}
        >
          <thead>
            <tr style={{ background: '#f3f4f6' }}>
              <th style={{ padding: '6px 8px', textAlign: 'left' }}>Username</th>
              <th style={{ padding: '6px 8px', textAlign: 'left' }}>Nama Lengkap</th>
              <th style={{ padding: '6px 8px', textAlign: 'left' }}>Role</th>
              <th style={{ padding: '6px 8px', textAlign: 'left' }}>Status</th>
              <th style={{ padding: '6px 8px', textAlign: 'left' }}>Aksi</th>
            </tr>
          </thead>
          <tbody>
            {users.map((u) => (
              <tr key={u.id}>
                <td style={{ padding: '4px 8px', borderTop: '1px solid #e5e7eb' }}>{u.username}</td>
                <td style={{ padding: '4px 8px', borderTop: '1px solid #e5e7eb' }}>
                  <input
                    type="text"
                    value={u.full_name}
                    onChange={(e) =>
                      setUsers((prev) =>
                        prev.map((x) =>
                          x.id === u.id
                            ? {
                                ...x,
                                full_name: e.target.value
                              }
                            : x
                        )
                      )
                    }
                    style={{
                      width: '100%',
                      padding: '4px 6px',
                      borderRadius: 6,
                      border: '1px solid #d1d5db',
                      fontSize: 12
                    }}
                  />
                </td>
                <td style={{ padding: '4px 8px', borderTop: '1px solid #e5e7eb' }}>
                  <select
                    value={u.role}
                    onChange={(e) => handleRoleChange(u.id, e.target.value as AppUser['role'])}
                    style={{
                      width: '100%',
                      padding: '4px 6px',
                      borderRadius: 6,
                      border: '1px solid #d1d5db',
                      fontSize: 12
                    }}
                  >
                    <option value="pendaftaran">Pendaftaran</option>
                    <option value="dokter">Dokter</option>
                    <option value="farmasi">Farmasi</option>
                    <option value="kasir">Kasir</option>
                    <option value="admin">Admin</option>
                  </select>
                </td>
                <td style={{ padding: '4px 8px', borderTop: '1px solid #e5e7eb' }}>
                  <label style={{ display: 'inline-flex', alignItems: 'center', gap: 4, fontSize: 11 }}>
                    <input
                      type="checkbox"
                      checked={u.is_active ?? true}
                      onChange={(e) => handleToggleActive(u.id, e.target.checked)}
                    />
                    {u.is_active ?? true ? 'Aktif' : 'Nonaktif'}
                  </label>
                </td>
                <td style={{ padding: '4px 8px', borderTop: '1px solid #e5e7eb' }}>
                  <button
                    onClick={() => void handleUpdate(u)}
                    disabled={savingId === u.id}
                    style={{
                      padding: '4px 8px',
                      borderRadius: 999,
                      border: 'none',
                      background: savingId === u.id ? '#9ca3af' : '#1AB1E5',
                      color: '#fff',
                      cursor: savingId === u.id ? 'default' : 'pointer',
                      fontSize: 11,
                      marginRight: 4
                    }}
                  >
                    Simpan
                  </button>
                  <button
                    onClick={() => void handleResetPassword(u)}
                    disabled={savingId === u.id}
                    style={{
                      padding: '4px 8px',
                      borderRadius: 999,
                      border: 'none',
                      background: '#f97316',
                      color: '#fff',
                      cursor: savingId === u.id ? 'default' : 'pointer',
                      fontSize: 11
                    }}
                  >
                    Reset PW
                  </button>
                </td>
              </tr>
            ))}
            {users.length === 0 && (
              <tr>
                <td
                  colSpan={5}
                  style={{
                    padding: '8px 8px',
                    textAlign: 'center',
                    color: '#9ca3af',
                    borderTop: '1px solid #e5e7eb'
                  }}
                >
                  Belum ada user lain selain admin default.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </section>
  );
};
const PendaftaranView: React.FC = () => {
  const [poli, setPoli] = React.useState<Poli[]>([]);
  const [dokter, setDokter] = React.useState<Dokter[]>([]);
  const [penjab, setPenjab] = React.useState<Penjab[]>([]);
  const [regToday, setRegToday] = React.useState<RegToday[]>([]);
  const [loading, setLoading] = React.useState<boolean>(false);
  const [error, setError] = React.useState<string | null>(null);

  const [noRkmMedis, setNoRkmMedis] = React.useState<string>('');
  const [selectedPoli, setSelectedPoli] = React.useState<string>('');
  const [selectedDokter, setSelectedDokter] = React.useState<string>('');
  const [kdPj, setKdPj] = React.useState<string>(''); // akan di-set otomatis setelah load penjab
  const [saving, setSaving] = React.useState<boolean>(false);
  const [info, setInfo] = React.useState<string | null>(null);

  const [patient, setPatient] = React.useState<PatientBrief | null>(null);
  const [patientLoading, setPatientLoading] = React.useState<boolean>(false);
  const [patientError, setPatientError] = React.useState<string | null>(null);

  const [filterPoli, setFilterPoli] = React.useState<string>('');
  const [filterDokter, setFilterDokter] = React.useState<string>('');
  const [searchText, setSearchText] = React.useState<string>('');

  const loadData = async () => {
    setLoading(true);
    setError(null);
    try {
      const [poliRes, dokterRes, penjabRes, regRes] = await Promise.all([
        fetch('/api/pendaftaran/poli'),
        fetch('/api/pendaftaran/dokter'),
        fetch('/api/pendaftaran/penjab'),
        fetch('/api/pendaftaran/today')
      ]);

      if (!poliRes.ok || !dokterRes.ok || !penjabRes.ok || !regRes.ok) {
        throw new Error('Gagal mengambil data pendaftaran');
      }

      const [poliJson, dokterJson, penjabJson, regJson] = await Promise.all([
        poliRes.json(),
        dokterRes.json(),
        penjabRes.json(),
        regRes.json()
      ]);

      // Antisipasi jika backend mengirim null (slice kosong di Go -> null dalam JSON),
      // kita paksa menjadi array kosong agar tidak error saat .length / .map.
      const poliData: Poli[] = Array.isArray(poliJson) ? poliJson : [];
      const dokterData: Dokter[] = Array.isArray(dokterJson) ? dokterJson : [];
      const penjabData: Penjab[] = Array.isArray(penjabJson) ? penjabJson : [];
      const regData: RegToday[] = Array.isArray(regJson) ? regJson : [];

      setPoli(poliData);
      setDokter(dokterData);
      setPenjab(penjabData);
      setRegToday(regData);

      // jika kdPj belum diset dan ada data penjab, pilih yang pertama sebagai default
      if (!kdPj && penjabData.length > 0) {
        setKdPj(penjabData[0].kd_pj);
      }
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan');
    } finally {
      setLoading(false);
    }
  };

  React.useEffect(() => {
    void loadData();
  }, []);

  const fetchPatient = async (no: string) => {
    setPatient(null);
    setPatientError(null);
    if (!no) {
      return;
    }
    setPatientLoading(true);
    try {
      const res = await fetch(`/api/pendaftaran/pasien/${encodeURIComponent(no)}`);
      if (res.status === 404) {
        setPatientError('Pasien tidak ditemukan di tabel pasien.');
        return;
      }
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error((data as any).error || 'Gagal mengambil data pasien');
      }
      const data: PatientBrief = await res.json();
      setPatient(data);
    } catch (e) {
      setPatientError(e instanceof Error ? e.message : 'Terjadi kesalahan saat mengambil pasien');
    } finally {
      setPatientLoading(false);
    }
  };

  const filteredRegToday = React.useMemo(() => {
    const search = searchText.trim().toLowerCase();
    return regToday.filter((r) => {
      if (filterPoli && r.kd_poli !== filterPoli) return false;
      if (filterDokter && r.kd_dokter !== filterDokter) return false;
      if (search) {
        const haystack = `${r.no_rkm_medis} ${r.nm_pasien}`.toLowerCase();
        if (!haystack.includes(search)) return false;
      }
      return true;
    });
  }, [regToday, filterPoli, filterDokter, searchText]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    setInfo(null);

    if (!noRkmMedis || !selectedPoli || !selectedDokter || !kdPj) {
      setError('Lengkapi No. RM, Poli, Dokter, dan Cara Bayar.');
      return;
    }

    if (!patient) {
      setError('No. RM belum valid / pasien belum ditemukan. Mohon cek data pasien dahulu.');
      return;
    }

    setSaving(true);
    try {
      const res = await fetch('/api/pendaftaran/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          no_rkm_medis: noRkmMedis,
          kd_poli: selectedPoli,
          kd_dokter: selectedDokter,
          kd_pj: kdPj
        })
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Gagal menyimpan pendaftaran');
      }

      setInfo(`Pendaftaran berhasil. No. Rawat: ${data.no_rawat}, No. Reg: ${data.no_reg}`);
      setNoRkmMedis('');
      setSelectedPoli('');
      setSelectedDokter('');

      // refresh daftar pendaftaran hari ini
      await loadData();
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Terjadi kesalahan saat simpan');
    } finally {
      setSaving(false);
    }
  };

  return (
    <section
      style={{
        background: '#ffffff',
        borderRadius: 16,
        padding: 24,
        boxShadow: '0 10px 30px rgba(15,23,42,0.08)',
        border: '1px solid #e5e7eb'
      }}
    >
      <div
        style={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          marginBottom: 16
        }}
      >
        <div>
          <h2 style={{ marginTop: 0, marginBottom: 4 }}>Pendaftaran Rawat Jalan</h2>
          <p style={{ margin: 0, color: '#6b7280', fontSize: 13 }}>
            Data poli, dokter, dan daftar pendaftaran hari ini yang diambil langsung dari database
            <code> ibnusinadev</code>.
          </p>
        </div>
        <button
          onClick={loadData}
          disabled={loading}
          style={{
            padding: '8px 12px',
            borderRadius: 999,
            border: 'none',
            background: loading ? '#9ca3af' : '#16a34a',
            color: '#fff',
            cursor: loading ? 'default' : 'pointer',
            fontSize: 12,
            fontWeight: 500
          }}
        >
          {loading ? 'Memuat…' : 'Refresh Data'}
        </button>
      </div>

      {error && (
        <div
          style={{
            marginBottom: 16,
            padding: 10,
            borderRadius: 8,
            background: '#fef2f2',
            color: '#b91c1c',
            fontSize: 13
          }}
        >
          {error}
        </div>
      )}

      <form
        onSubmit={handleSubmit}
        style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))',
          gap: 16,
          alignItems: 'flex-start',
          marginBottom: 16,
          padding: 16,
          borderRadius: 12,
          border: '1px solid #e5e7eb',
          background: '#f9fafb',
          fontSize: 13
        }}
      >
        <div>
          <h3 style={{ marginTop: 0, marginBottom: 8, fontSize: 14 }}>Input Pendaftaran Baru</h3>
          <div style={{ marginBottom: 8 }}>
            <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>No. Rekam Medis</label>
            <input
              type="text"
              value={noRkmMedis}
              onChange={(e) => {
                setNoRkmMedis(e.target.value);
              }}
              onBlur={() => {
                void fetchPatient(noRkmMedis.trim());
              }}
              placeholder="Contoh: 000001"
              style={{
                width: '100%',
                padding: '6px 8px',
                borderRadius: 8,
                border: '1px solid #d1d5db',
                fontSize: 13
              }}
            />
          </div>
          <div style={{ marginBottom: 8 }}>
            <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Poliklinik</label>
            <select
              value={selectedPoli}
              onChange={(e) => setSelectedPoli(e.target.value)}
              style={{
                width: '100%',
                padding: '6px 8px',
                borderRadius: 8,
                border: '1px solid #d1d5db',
                fontSize: 13
              }}
            >
              <option value="">Pilih Poli</option>
              {poli.map((p) => (
                <option key={p.kd_poli} value={p.kd_poli}>
                  {p.nm_poli}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div>
          <h3 style={{ marginTop: 0, marginBottom: 8, fontSize: 14, visibility: 'hidden' }}>.</h3>
          <div style={{ marginBottom: 8 }}>
            <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Dokter</label>
            <select
              value={selectedDokter}
              onChange={(e) => setSelectedDokter(e.target.value)}
              style={{
                width: '100%',
                padding: '6px 8px',
                borderRadius: 8,
                border: '1px solid #d1d5db',
                fontSize: 13
              }}
            >
              <option value="">Pilih Dokter</option>
              {dokter.map((d) => (
                <option key={d.kd_dokter} value={d.kd_dokter}>
                  {d.nm_dokter}
                </option>
              ))}
            </select>
          </div>
          <div style={{ marginBottom: 8 }}>
            <label style={{ display: 'block', fontSize: 12, marginBottom: 4 }}>Cara Bayar / Penjamin</label>
            <select
              value={kdPj}
              onChange={(e) => setKdPj(e.target.value)}
              style={{
                width: '100%',
                padding: '6px 8px',
                borderRadius: 8,
                border: '1px solid #d1d5db',
                fontSize: 13
              }}
            >
              <option value="">Pilih Cara Bayar</option>
              {penjab.map((p) => (
                <option key={p.kd_pj} value={p.kd_pj}>
                  {p.nm_pj} ({p.kd_pj})
                </option>
              ))}
            </select>
          </div>
          <button
            type="submit"
            disabled={saving}
            style={{
              marginTop: 4,
              padding: '8px 14px',
              borderRadius: 999,
              border: 'none',
              background: saving ? '#9ca3af' : '#16a34a',
              color: '#fff',
              cursor: saving ? 'default' : 'pointer',
              fontSize: 13,
              fontWeight: 500
            }}
          >
            {saving ? 'Menyimpan…' : 'Simpan Pendaftaran'}
          </button>
        </div>
      </form>

      {info && (
        <div
          style={{
            marginBottom: 12,
            padding: 10,
            borderRadius: 8,
            background: '#ecfdf3',
            color: '#166534',
            fontSize: 13
          }}
        >
          {info}
        </div>
      )}

      {/* Info pasien singkat */}
      <div
        style={{
          marginBottom: 12,
          padding: 12,
          borderRadius: 12,
          border: '1px solid #e5e7eb',
          background: '#f9fafb',
          fontSize: 13
        }}
      >
        <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 4 }}>
          <strong>Data Pasien</strong>
          {patientLoading && <span style={{ fontSize: 11, color: '#6b7280' }}>Memuat data pasien…</span>}
        </div>
        {patient ? (
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(160px, 1fr))', gap: 8 }}>
            <div>
              <div style={{ fontSize: 11, color: '#6b7280' }}>No. RM</div>
              <div>{patient.no_rkm_medis}</div>
            </div>
            <div>
              <div style={{ fontSize: 11, color: '#6b7280' }}>Nama</div>
              <div>{patient.nm_pasien}</div>
            </div>
            <div>
              <div style={{ fontSize: 11, color: '#6b7280' }}>JK / Tgl Lahir</div>
              <div>
                {patient.jk} / {patient.tgl_lahir}
              </div>
            </div>
            <div style={{ gridColumn: '1 / -1' }}>
              <div style={{ fontSize: 11, color: '#6b7280' }}>Alamat</div>
              <div>{patient.alamat}</div>
            </div>
          </div>
        ) : patientError ? (
          <div style={{ fontSize: 12, color: '#b91c1c' }}>{patientError}</div>
        ) : (
          <div style={{ fontSize: 12, color: '#9ca3af' }}>Isi No. RM kemudian keluar dari kolom untuk melihat data pasien.</div>
        )}
      </div>

      <div
        style={{
          display: 'grid',
          gridTemplateColumns: 'minmax(0, 260px) minmax(0, 1fr)',
          gap: 16,
          alignItems: 'flex-start'
        }}
      >
        {/* Panel referensi poli & dokter */}
        <div
          style={{
            borderRadius: 12,
            border: '1px solid #e5e7eb',
            padding: 14,
            background: '#f9fafb',
            fontSize: 13
          }}
        >
          <h3 style={{ marginTop: 0, marginBottom: 8, fontSize: 14 }}>Referensi Poli</h3>
          <div
            style={{
              maxHeight: 180,
              overflowY: 'auto',
              borderRadius: 8,
              border: '1px solid #e5e7eb',
              background: '#fff'
            }}
          >
            <table
              style={{
                width: '100%',
                borderCollapse: 'collapse',
                fontSize: 12
              }}
            >
              <thead>
                <tr style={{ background: '#f3f4f6' }}>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Kode</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Poliklinik</th>
                </tr>
              </thead>
              <tbody>
                {poli.map((p) => (
                  <tr key={p.kd_poli}>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{p.kd_poli}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{p.nm_poli}</td>
                  </tr>
                ))}
                {poli.length === 0 && (
                  <tr>
                    <td
                      colSpan={2}
                      style={{
                        padding: '6px 8px',
                        textAlign: 'center',
                        color: '#9ca3af'
                      }}
                    >
                      Tidak ada data poli
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          <h3 style={{ marginTop: 16, marginBottom: 8, fontSize: 14 }}>Referensi Dokter</h3>
          <div
            style={{
              maxHeight: 180,
              overflowY: 'auto',
              borderRadius: 8,
              border: '1px solid #e5e7eb',
              background: '#fff'
            }}
          >
            <table
              style={{
                width: '100%',
                borderCollapse: 'collapse',
                fontSize: 12
              }}
            >
              <thead>
                <tr style={{ background: '#f3f4f6' }}>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Kode</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Nama</th>
                </tr>
              </thead>
              <tbody>
                {dokter.map((d) => (
                  <tr key={d.kd_dokter}>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{d.kd_dokter}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{d.nm_dokter}</td>
                  </tr>
                ))}
                {dokter.length === 0 && (
                  <tr>
                    <td
                      colSpan={2}
                      style={{
                        padding: '6px 8px',
                        textAlign: 'center',
                        color: '#9ca3af'
                      }}
                    >
                      Tidak ada data dokter
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

        {/* Tabel pendaftaran hari ini */}
        <div
          style={{
            borderRadius: 12,
            border: '1px solid #e5e7eb',
            padding: 14,
            background: '#f9fafb',
            fontSize: 13
          }}
        >
          <div
            style={{
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              marginBottom: 8,
              gap: 12,
              flexWrap: 'wrap'
            }}
          >
            <h3 style={{ margin: 0, fontSize: 14 }}>Daftar Pendaftaran Hari Ini</h3>
            <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
              <select
                value={filterPoli}
                onChange={(e) => setFilterPoli(e.target.value)}
                style={{
                  padding: '4px 8px',
                  borderRadius: 999,
                  border: '1px solid #d1d5db',
                  fontSize: 11,
                  background: '#fff'
                }}
              >
                <option value="">Semua Poli</option>
                {poli.map((p) => (
                  <option key={p.kd_poli} value={p.kd_poli}>
                    {p.nm_poli}
                  </option>
                ))}
              </select>
              <select
                value={filterDokter}
                onChange={(e) => setFilterDokter(e.target.value)}
                style={{
                  padding: '4px 8px',
                  borderRadius: 999,
                  border: '1px solid #d1d5db',
                  fontSize: 11,
                  background: '#fff'
                }}
              >
                <option value="">Semua Dokter</option>
                {dokter.map((d) => (
                  <option key={d.kd_dokter} value={d.kd_dokter}>
                    {d.nm_dokter}
                  </option>
                ))}
              </select>
              <input
                type="text"
                value={searchText}
                onChange={(e) => setSearchText(e.target.value)}
                placeholder="Cari No. RM / Nama"
                style={{
                  padding: '4px 8px',
                  borderRadius: 999,
                  border: '1px solid #d1d5db',
                  fontSize: 11,
                  minWidth: 140
                }}
              />
              <span style={{ fontSize: 11, color: '#6b7280' }}>
                Total: <strong>{filteredRegToday.length}</strong> kunjungan
              </span>
            </div>
          </div>

          <div
            style={{
              maxHeight: 360,
              overflow: 'auto',
              borderRadius: 8,
              border: '1px solid #e5e7eb',
              background: '#fff'
            }}
          >
            <table
              style={{
                width: '100%',
                borderCollapse: 'collapse',
                fontSize: 12
              }}
            >
              <thead>
                <tr style={{ background: '#f3f4f6' }}>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>No. Rawat</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>No. RM</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Nama Pasien</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Jam</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Poli</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Dokter</th>
                  <th style={{ padding: '6px 8px', textAlign: 'left' }}>Status</th>
                </tr>
              </thead>
              <tbody>
                {filteredRegToday.map((r) => (
                  <tr key={r.no_rawat}>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6', whiteSpace: 'nowrap' }}>
                      {r.no_rawat}
                    </td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{r.no_rkm_medis}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{r.nm_pasien}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{r.jam_reg}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{r.nm_poli}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>{r.nm_dokter}</td>
                    <td style={{ padding: '4px 8px', borderTop: '1px solid #f3f4f6' }}>
                      <span
                        style={{
                          padding: '2px 8px',
                          borderRadius: 999,
                          background:
                            r.status_lanjut === 'Ralan'
                              ? '#ecfdf3'
                              : r.status_lanjut === 'Ranap'
                              ? '#e0f2fe'
                              : '#fefce8',
                          color:
                            r.status_lanjut === 'Ralan'
                              ? '#166534'
                              : r.status_lanjut === 'Ranap'
                              ? '#0891B2'
                              : '#92400e',
                          fontSize: 11
                        }}
                      >
                        {r.status_lanjut} / {r.stts}
                      </span>
                    </td>
                  </tr>
                ))}
                {filteredRegToday.length === 0 && (
                  <tr>
                    <td
                      colSpan={7}
                      style={{
                        padding: '8px 8px',
                        textAlign: 'center',
                        color: '#9ca3af'
                      }}
                    >
                      Belum ada pendaftaran untuk hari ini atau data tidak ditemukan.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  );
};

export const App: React.FC = () => {
  const [user, setUser] = React.useState<AppUser | null>(null);
  const [activeMenu, setActiveMenu] = React.useState<MenuKey>('dashboard');
  const [health, setHealth] = React.useState<string>('Belum cek');
  const [loadingHealth, setLoadingHealth] = React.useState<boolean>(false);
  const [selectedPatientForSoap, setSelectedPatientForSoap] = React.useState<any>(null);

  const menuItems: { key: MenuKey; label: string }[] = [
    { key: 'dashboard', label: 'Dashboard' },
    { key: 'pendaftaran', label: 'Pendaftaran' },
    { key: 'igd', label: 'IGD' },
    { key: 'rawat-jalan', label: 'Rawat Jalan' },
    { key: 'rawat-inap', label: 'Rawat Inap' },
    { key: 'radiologi', label: 'Radiologi' },
    { key: 'laboratorium', label: 'Laboratorium' },
    { key: 'farmasi', label: 'Farmasi' },
    { key: 'kasir', label: 'Kasir' },
    { key: 'kepegawaian', label: 'Kepegawaian' },
    { key: 'anjungan-antrian', label: 'Anjungan & Antrian' },
    { key: 'rekam-medis', label: 'Rekam Medis' },
    { key: 'berkas-digital', label: 'Berkas Digital' },
    { key: 'jadwal-operasi', label: 'Jadwal Operasi' },
    { key: 'laporan', label: 'Laporan' },
    { key: 'admin', label: 'Pengaturan' }
  ];

  // Menu yang ditampilkan di sidebar (hanya modul utama)
  const sidebarMenuKeys: MenuKey[] = [
    'dashboard',
    'rawat-jalan',
    'rawat-inap',
    'farmasi',
    'radiologi',
    'laboratorium',
    'jadwal-operasi'
  ];

  const checkBackend = async () => {
    setLoadingHealth(true);
    try {
      const res = await fetch('/api/health');
      const data = await res.json();
      setHealth(`Status: ${data.status}, DB: ${data.db}`);
    } catch (e) {
      setHealth('Gagal konek ke backend');
    } finally {
      setLoadingHealth(false);
    }
  };

  React.useEffect(() => {
    void checkBackend();
  }, []);

  React.useEffect(() => {
    const stored = window.localStorage.getItem('ermapp_user');
    if (stored) {
      try {
        const parsed = JSON.parse(stored) as AppUser;
        setUser(parsed);
      } catch {
        window.localStorage.removeItem('ermapp_user');
      }
    }
  }, []);

  const handleLogin = (u: AppUser) => {
    setUser(u);
    window.localStorage.setItem('ermapp_user', JSON.stringify(u));
  };

  const handleLogout = () => {
    setUser(null);
    window.localStorage.removeItem('ermapp_user');
  };

  const canAccessMenu = (menu: MenuKey, role: AppUser['role']) => {
    switch (role) {
      case 'pendaftaran':
        return menu === 'dashboard' || menu === 'pendaftaran' || menu === 'anjungan-antrian';
      case 'dokter':
        return menu === 'dashboard' || menu === 'rawat-jalan' || menu === 'rawat-inap' ||
               menu === 'radiologi' || menu === 'laboratorium' || menu === 'jadwal-operasi' ||
               menu === 'rekam-medis' || menu === 'laporan';
      case 'farmasi':
        return menu === 'dashboard' || menu === 'farmasi' || menu === 'laporan';
      case 'kasir':
        return menu === 'dashboard' || menu === 'kasir' || menu === 'laporan';
      case 'admin':
      default:
        return true;
    }
  };

  if (!user) {
    return <LoginView onLogin={handleLogin} />;
  }

  const visibleMenuItems = menuItems.filter((m) => canAccessMenu(m.key, user.role));

  // Filter menu untuk sidebar - hanya tampilkan yang ada di sidebarMenuKeys
  const sidebarVisibleMenuItems = menuItems.filter((m) =>
    sidebarMenuKeys.includes(m.key) && canAccessMenu(m.key, user.role)
  );

  const renderContent = () => {
    switch (activeMenu) {
      case 'dashboard':
        return <DashboardView user={user} setActiveMenu={setActiveMenu} canAccessMenu={canAccessMenu} />;
      case 'pendaftaran':
          {
            key: 'pendaftaran' as MenuKey,
            label: 'Pendaftaran',
            description: 'Pendaftaran pasien rawat jalan dan rawat inap',
            icon: '📋',
            color: '#10b981',
            bgColor: 'rgba(16, 185, 129, 0.08)',
            borderColor: 'rgba(16, 185, 129, 0.2)'
          },
          {
            key: 'igd' as MenuKey,
            label: 'IGD',
            description: 'Instalasi Gawat Darurat & triase pasien',
            icon: '🚑',
            color: '#ef4444',
            bgColor: 'rgba(239, 68, 68, 0.08)',
            borderColor: 'rgba(239, 68, 68, 0.2)'
          },
          {
            key: 'rawat-jalan' as MenuKey,
            label: 'Rawat Jalan',
            description: 'Pemeriksaan poli, SOAP, resep & tindakan',
            icon: '👨‍⚕️',
            color: '#3b82f6',
            bgColor: 'rgba(59, 130, 246, 0.08)',
            borderColor: 'rgba(59, 130, 246, 0.2)'
          },
          {
            key: 'rawat-inap' as MenuKey,
            label: 'Rawat Inap',
            description: 'Manajemen bed, DPJP & catatan perawatan',
            icon: '🏥',
            color: '#8b5cf6',
            bgColor: 'rgba(139, 92, 246, 0.08)',
            borderColor: 'rgba(139, 92, 246, 0.2)'
          },
          {
            key: 'radiologi' as MenuKey,
            label: 'Radiologi',
            description: 'Permintaan & hasil pemeriksaan radiologi',
            icon: '🩻',
            color: '#7c3aed',
            bgColor: 'rgba(124, 58, 237, 0.08)',
            borderColor: 'rgba(124, 58, 237, 0.2)'
          },
          {
            key: 'laboratorium' as MenuKey,
            label: 'Laboratorium',
            description: 'Pemeriksaan lab PK, PA & hasil laboratorium',
            icon: '🔬',
            color: '#0891b2',
            bgColor: 'rgba(8, 145, 178, 0.08)',
            borderColor: 'rgba(8, 145, 178, 0.2)'
          },
          {
            key: 'farmasi' as MenuKey,
            label: 'Farmasi',
            description: 'Pengelolaan stok obat & distribusi resep',
            icon: '💊',
            color: '#06b6d4',
            bgColor: 'rgba(6, 182, 212, 0.08)',
            borderColor: 'rgba(6, 182, 212, 0.2)'
          },
          {
            key: 'kasir' as MenuKey,
            label: 'Kasir',
            description: 'Billing pasien & pembayaran',
            icon: '💳',
            color: '#f59e0b',
            bgColor: 'rgba(245, 158, 11, 0.08)',
            borderColor: 'rgba(245, 158, 11, 0.2)'
          },
          {
            key: 'kepegawaian' as MenuKey,
            label: 'Kepegawaian',
            description: 'Data pegawai, dokter, perawat & SDM',
            icon: '👥',
            color: '#14b8a6',
            bgColor: 'rgba(20, 184, 166, 0.08)',
            borderColor: 'rgba(20, 184, 166, 0.2)'
          },
          {
            key: 'anjungan-antrian' as MenuKey,
            label: 'Anjungan & Antrian',
            description: 'Sistem antrian & display anjungan pasien',
            icon: '🎫',
            color: '#f43f5e',
            bgColor: 'rgba(244, 63, 94, 0.08)',
            borderColor: 'rgba(244, 63, 94, 0.2)'
          },
          {
            key: 'rekam-medis' as MenuKey,
            label: 'Rekam Medis',
            description: 'Pengelolaan rekam medis & dokumentasi',
            icon: '📁',
            color: '#8b5cf6',
            bgColor: 'rgba(139, 92, 246, 0.08)',
            borderColor: 'rgba(139, 92, 246, 0.2)'
          },
          {
            key: 'berkas-digital' as MenuKey,
            label: 'Berkas Digital',
            description: 'Arsip dokumen & berkas digital pasien',
            icon: '📄',
            color: '#0ea5e9',
            bgColor: 'rgba(14, 165, 233, 0.08)',
            borderColor: 'rgba(14, 165, 233, 0.2)'
          },
          {
            key: 'jadwal-operasi' as MenuKey,
            label: 'Jadwal Operasi',
            description: 'Penjadwalan & manajemen operasi ruang OK',
            icon: '🏥',
            color: '#dc2626',
            bgColor: 'rgba(220, 38, 38, 0.08)',
            borderColor: 'rgba(220, 38, 38, 0.2)'
          },
          {
            key: 'laporan' as MenuKey,
            label: 'Laporan',
            description: 'Laporan kunjungan, BOR, LOS & pendapatan',
            icon: '📊',
            color: '#ec4899',
            bgColor: 'rgba(236, 72, 153, 0.08)',
            borderColor: 'rgba(236, 72, 153, 0.2)'
          },
          {
            key: 'admin' as MenuKey,
            label: 'Pengaturan',
            description: 'Manajemen user & hak akses sistem',
            icon: '⚙️',
            color: '#64748b',
            bgColor: 'rgba(100, 116, 139, 0.08)',
            borderColor: 'rgba(100, 116, 139, 0.2)'
          }
        ];

        return (
          <section
            style={{
              background: '#ffffff',
              borderRadius: 16,
              padding: 24,
              boxShadow: '0 10px 30px rgba(15,23,42,0.08)',
              border: '1px solid #e5e7eb'
            }}
          >
            <h2 style={{ marginTop: 0, marginBottom: 4 }}>Dashboard</h2>
            <p style={{ marginTop: 0, marginBottom: 24, color: '#6b7280' }}>
              Selamat datang di SIMRS Web. Pilih modul yang ingin Anda akses.
            </p>

            {/* Status System Section */}
            <div
              style={{
                display: 'grid',
                gridTemplateColumns: 'repeat(auto-fit, minmax(280px, 1fr))',
                gap: 16,
                marginBottom: 24
              }}
            >
              <div
                style={{
                  padding: 16,
                  borderRadius: 12,
                  background: 'linear-gradient(135deg, rgba(37,99,235,0.06), rgba(59,130,246,0.12))',
                  border: '1px solid rgba(37,99,235,0.18)'
                }}
              >
                <h3 style={{ marginTop: 0, marginBottom: 8, fontSize: 14, color: '#0891B2' }}>
                  Status Backend & Database
                </h3>
                <p style={{ margin: 0, fontSize: 13 }}>
                  <strong>Hasil:</strong> {health}
                </p>
                <button
                  onClick={checkBackend}
                  disabled={loadingHealth}
                  style={{
                    marginTop: 12,
                    padding: '6px 12px',
                    borderRadius: 999,
                    border: 'none',
                    background: loadingHealth ? '#9ca3af' : '#1AB1E5',
                    color: '#fff',
                    cursor: loadingHealth ? 'default' : 'pointer',
                    fontSize: 12,
                    fontWeight: 500
                  }}
                >
                  {loadingHealth ? 'Mengecek…' : 'Cek Ulang'}
                </button>
              </div>

              <div
                style={{
                  padding: 16,
                  borderRadius: 12,
                  background: '#f9fafb',
                  border: '1px dashed #e5e7eb',
                  fontSize: 13,
                  color: '#4b5563'
                }}
              >
                <strong>Informasi User</strong>
                <ul style={{ marginTop: 8, paddingLeft: 18, marginBottom: 0 }}>
                  <li>Login sebagai: <strong>{user.full_name}</strong></li>
                  <li>Role: <strong style={{ textTransform: 'capitalize' }}>{user.role}</strong></li>
                  <li>Database: <code>ibnusinadev</code></li>
                </ul>
              </div>
            </div>

            {/* Module Cards Section */}
            <div style={{ marginBottom: 16 }}>
              <h3 style={{ marginTop: 0, marginBottom: 12, fontSize: 16, color: '#111827' }}>
                Modul Aplikasi
              </h3>
              <div
                style={{
                  display: 'grid',
                  gridTemplateColumns: 'repeat(auto-fill, minmax(240px, 1fr))',
                  gap: 16
                }}
              >
                {moduleCards
                  .filter((mod) => canAccessMenu(mod.key, user.role))
                  .map((mod) => (
                    <button
                      key={mod.key}
                      onClick={() => setActiveMenu(mod.key)}
                      style={{
                        padding: 20,
                        borderRadius: 12,
                        border: `1px solid ${mod.borderColor}`,
                        background: mod.bgColor,
                        cursor: 'pointer',
                        textAlign: 'left',
                        transition: 'all 0.2s ease',
                        display: 'flex',
                        flexDirection: 'column',
                        gap: 8
                      }}
                      onMouseEnter={(e) => {
                        e.currentTarget.style.transform = 'translateY(-4px)';
                        e.currentTarget.style.boxShadow = '0 12px 24px rgba(0,0,0,0.1)';
                      }}
                      onMouseLeave={(e) => {
                        e.currentTarget.style.transform = 'translateY(0)';
                        e.currentTarget.style.boxShadow = 'none';
                      }}
                    >
                      <div
                        style={{
                          fontSize: 32,
                          lineHeight: 1
                        }}
                      >
                        {mod.icon}
                      </div>
                      <div>
                        <h4
                          style={{
                            margin: 0,
                            fontSize: 16,
                            fontWeight: 600,
                            color: mod.color,
                            marginBottom: 4
                          }}
                        >
                          {mod.label}
                        </h4>
                        <p
                          style={{
                            margin: 0,
                            fontSize: 12,
                            color: '#6b7280',
                            lineHeight: 1.5
                          }}
                        >
                          {mod.description}
                        </p>
                      </div>
                    </button>
                  ))}
              </div>
            </div>

            {/* Quick Info */}
            <div
              style={{
                marginTop: 24,
                padding: 16,
                borderRadius: 12,
                background: 'linear-gradient(135deg, rgba(16, 185, 129, 0.05), rgba(6, 182, 212, 0.05))',
                border: '1px solid rgba(16, 185, 129, 0.15)',
                fontSize: 13,
                color: '#4b5563'
              }}
            >
              <strong style={{ display: 'block', marginBottom: 8, color: '#059669' }}>
                Petunjuk Penggunaan
              </strong>
              <ul style={{ marginTop: 0, paddingLeft: 18, marginBottom: 0 }}>
                <li>Klik pada card modul di atas untuk mengakses fitur yang tersedia</li>
                <li>Modul yang ditampilkan disesuaikan dengan hak akses role Anda</li>
                <li>Gunakan menu sidebar di sebelah kiri untuk navigasi cepat</li>
                <li>Arsitektur: Backend Go + Frontend React + MySQL Database</li>
              </ul>
            </div>
          </section>
        );
      case 'pendaftaran':
        return <PendaftaranView />;
      case 'igd':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>IGD</h2>
            <p style={{ color: '#6b7280' }}>Monitoring pasien IGD, triase, dan tindakan emergensi.</p>
          </section>
        );
      case 'rawat-jalan':
        return (
          <RawatJalanView
            onOpenSoap={(patient) => setSelectedPatientForSoap(patient)}
          />
        );
      case 'rawat-inap':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Rawat Inap</h2>
            <p style={{ color: '#6b7280' }}>Manajemen bed, DPJP, order, dan catatan perawatan.</p>
          </section>
        );
      case 'radiologi':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Radiologi</h2>
            <p style={{ color: '#6b7280' }}>Permintaan pemeriksaan radiologi (Rontgen, CT Scan, MRI, USG) dan hasil pemeriksaan.</p>
          </section>
        );
      case 'laboratorium':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Laboratorium</h2>
            <p style={{ color: '#6b7280' }}>Permintaan pemeriksaan laboratorium (Patologi Klinik, Patologi Anatomi) dan hasil lab.</p>
          </section>
        );
      case 'farmasi':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Farmasi</h2>
            <p style={{ color: '#6b7280' }}>Pengelolaan stok obat, resep, dan distribusi ke unit.</p>
          </section>
        );
      case 'kasir':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Kasir</h2>
            <p style={{ color: '#6b7280' }}>Billing pasien, pembayaran, dan rekapitulasi kas harian.</p>
          </section>
        );
      case 'kepegawaian':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Kepegawaian</h2>
            <p style={{ color: '#6b7280' }}>Data pegawai, dokter, perawat, dan manajemen SDM rumah sakit.</p>
          </section>
        );
      case 'anjungan-antrian':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Anjungan & Antrian</h2>
            <p style={{ color: '#6b7280' }}>Sistem antrian poli, display antrian, dan anjungan pendaftaran mandiri.</p>
          </section>
        );
      case 'rekam-medis':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Rekam Medis</h2>
            <p style={{ color: '#6b7280' }}>Pengelolaan rekam medis, dokumentasi pasien, dan riwayat perawatan lengkap.</p>
          </section>
        );
      case 'berkas-digital':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Berkas Digital</h2>
            <p style={{ color: '#6b7280' }}>Arsip dan penyimpanan dokumen digital, scan berkas, dan manajemen file pasien.</p>
          </section>
        );
      case 'jadwal-operasi':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Jadwal Operasi</h2>
            <p style={{ color: '#6b7280' }}>Penjadwalan operasi, booking ruang OK, tim operasi, dan monitoring status operasi.</p>
          </section>
        );
      case 'laporan':
        return (
          <section style={{ background: '#ffffff', borderRadius: 16, padding: 24, boxShadow: '0 10px 30px rgba(15,23,42,0.08)', border: '1px solid #e5e7eb' }}>
            <h2 style={{ marginTop: 0 }}>Laporan</h2>
            <p style={{ color: '#6b7280' }}>
              Laporan kunjungan, BOR, LOS, pendapatan, dan pelaporan ke dinas/BPJS.
            </p>
          </section>
        );
      case 'admin':
        return <AdminUsersView />;
      default:
        return null;
    }
  };

  // Fullscreen mode untuk Pemeriksaan
  if (selectedPatientForSoap) {
    return (
      <div style={{
        fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        height: '100vh',
        overflow: 'hidden'
      }}>
        <PemeriksaanView
          patient={selectedPatientForSoap}
          onBack={() => setSelectedPatientForSoap(null)}
        />
      </div>
    );
  }

  return (
    <div
      style={{
        fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        background: 'radial-gradient(circle at top left, #e0f2fe 0, #f9fafb 45%, #f0fdfa 100%)',
        minHeight: '100vh',
        display: 'flex'
      }}
    >
      {/* Sidebar */}
      <aside
        style={{
          width: 260,
          background: 'linear-gradient(180deg, #0891B2 0%, #0e7490 100%)',
          color: '#ffffff',
          display: 'flex',
          flexDirection: 'column',
          boxShadow: '4px 0 18px rgba(8,145,178,0.35)',
          position: 'sticky',
          top: 0,
          height: '100vh',
          overflow: 'hidden'
        }}
      >
        <div style={{ padding: '16px 14px 20px 14px', borderBottom: '1px solid rgba(255,255,255,0.2)', flexShrink: 0 }}>
          <div style={{ fontSize: 14, fontWeight: 600, letterSpacing: 0.4, color: '#ffffff' }}>
            SIMRS WEB
          </div>
          <div style={{ fontSize: 13, color: '#e0f2fe' }}>Khanza → Go + React</div>
        </div>

        <nav style={{ marginTop: 0, flex: 1, overflowY: 'auto', padding: '16px 14px 0 14px' }}>
          {sidebarVisibleMenuItems.map((item) => {
            const active = activeMenu === item.key;
            return (
              <button
                key={item.key}
                onClick={() => setActiveMenu(item.key)}
                style={{
                  width: '100%',
                  textAlign: 'left',
                  padding: '8px 10px',
                  marginBottom: 4,
                  borderRadius: 10,
                  border: 'none',
                  background: active ? 'rgba(255,255,255,0.2)' : 'transparent',
                  color: active ? '#ffffff' : 'rgba(255,255,255,0.8)',
                  cursor: 'pointer',
                  fontSize: 13,
                  fontWeight: active ? 600 : 400,
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center'
                }}
              >
                <span>{item.label}</span>
                {active && (
                  <span
                    style={{
                      width: 6,
                      height: 6,
                      borderRadius: '999px',
                      background: '#1AB1E5'
                    }}
                  />
                )}
              </button>
            );
          })}
        </nav>

        <div
          style={{
            padding: '12px 14px 16px 14px',
            borderTop: '1px solid rgba(255,255,255,0.2)',
            fontSize: 11,
            color: 'rgba(255,255,255,0.7)',
            flexShrink: 0
          }}
        >
          <div>Rumah Sakit: <strong>Contoh RS</strong></div>
          <div>Versi: 0.0.1 (layout awal)</div>
        </div>
      </aside>

      {/* Main area */}
      <div style={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
        {/* Topbar */}
        <header
          style={{
            height: 66,
            padding: '0 24px',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            borderBottom: '1px solid #e5e7eb',
            backdropFilter: 'blur(18px)',
            background: 'rgba(249,250,251,0.82)',
            position: 'sticky',
            top: 0,
            zIndex: 10
          }}
        >
          <div>
            <div style={{ fontSize: 18, fontWeight: 600, color: '#111827' }}>
              {visibleMenuItems.find((m) => m.key === activeMenu)?.label}
            </div>
            <div style={{ fontSize: 12, color: '#6b7280' }}>
              Modul SIMRS: {visibleMenuItems.find((m) => m.key === activeMenu)?.label}
            </div>
          </div>

          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 12,
              fontSize: 13,
              color: '#4b5563'
            }}
          >
            <span
              style={{
                padding: '4px 8px',
                borderRadius: 999,
                background: '#e0f2fe',
                color: '#0369a1',
                fontSize: 11,
                fontWeight: 600
              }}
            >
              ENV: DEV
            </span>
            <div
              style={{
                width: 32,
                height: 32,
                borderRadius: '999px',
                background:
                  'linear-gradient(135deg, #1AB1E5, #0891B2)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                color: '#e5e7eb',
                fontSize: 13,
                fontWeight: 600
              }}
            >
              {user.full_name
                .split(' ')
                .map((p) => p.charAt(0))
                .join('')
                .slice(0, 2)
                .toUpperCase()}
            </div>
            <button
              onClick={handleLogout}
              style={{
                padding: '4px 10px',
                borderRadius: 999,
                border: '1px solid #e5e7eb',
                background: '#ffffff',
                fontSize: 11,
                cursor: 'pointer'
              }}
            >
              Keluar
            </button>
          </div>
        </header>

        {/* Content */}
        <main
          style={{
            padding: 24,
            minHeight: 'calc(100vh - 64px)',
            boxSizing: 'border-box'
          }}
        >
          {renderContent()}
        </main>
      </div>
    </div>
  );
};


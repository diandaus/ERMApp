      {activeTab === 'cppt' && (
        <div style={{ padding: 24, textAlign: 'center', color: '#6b7280' }}>
          <p>Tab CPPT (Catatan Perkembangan Pasien Terintegrasi) - Belum diimplementasikan</p>
